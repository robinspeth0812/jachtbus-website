# Build settings of the site. Copy to .env, or set as secrets in the deploy workflow.

# Where the request form posts to, for example https://portal.jachtbusfoodtruck.nl/api/aanvraag
# Empty: the form shows the fallback with phone and WhatsApp.
PUBLIC_AANVRAAG_ENDPOINT=

# The portal, read once at build time, for example https://portal.jachtbusfoodtruck.nl
# Empty: the site builds from src/data/nieuw.ts, without reviews and references.
CMS_URL=

# Measuring, only ever after a yes in the cookie banner. Empty: the service is not
# loaded and not mentioned in the banner or on the cookie page.
PUBLIC_GA_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=
