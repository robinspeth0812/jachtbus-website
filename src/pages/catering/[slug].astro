---
// One template for every service, set up like the local pages: the first step of
// the form in view, then the jobs of this service, what is good to know, and the
// options that fit. The content lives in src/data/nieuw.ts.
import BusBase from '../../layouts/BusBase.astro';
import BusPageHero from '../../components/bus/BusPageHero.astro';
import BusFirstStep from '../../components/bus/BusFirstStep.astro';
import BusPlaces from '../../components/bus/BusPlaces.astro';
import BusCases from '../../components/bus/BusCases.astro';
import BusMoments from '../../components/bus/BusMoments.astro';
import BusStory from '../../components/bus/BusStory.astro';
import BusRoute from '../../components/bus/BusRoute.astro';
import BusFit from '../../components/bus/BusFit.astro';
import BusFaq from '../../components/bus/BusFaq.astro';
import BusRows from '../../components/bus/BusRows.astro';
import BusReviews from '../../components/bus/BusReviews.astro';
import BusClosing from '../../components/bus/BusClosing.astro';
import { datumVraag, locaties, services, url } from '../../data/nieuw';
import type { Service } from '../../data/nieuw';
import { getInhoud } from '../../lib/cms';
import { faqSchema, serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
interface Props {
  service: Service;
}
const { service } = Astro.props;
const crumbs = [
  { label: 'Catering', href: url('catering') },
  { label: service.nav, href: url(`catering/${service.slug}`) },
];
const { referenties } = await getInhoud();
// Location pages about this service, such as bruiloftscatering in Drenthe.
const lokaal = locaties.filter((item) => item.dienst === service.slug);
const cases = referenties.filter((item) =>
  service.soort === 'gelegenheid' ? item.gelegenheid === service.nav : item.mogelijkheden?.includes(service.nav),
);
// What people worry about joins the questions, so doubts are answered in one place.
const vragen = [
  ...service.faq,
  ...service.worries.map((item) => ({ vraag: `En ${item.title.replace(/^./, (c) => c.toLowerCase())}?`, antwoord: item.text })),
];
---

<BusBase
  title={service.metaTitle}
  description={service.metaDescription}
  crumbs={crumbs}
  schema={[serviceSchema(service.schemaName, service.metaDescription), faqSchema(vragen)]}
>
  <BusPageHero title={service.title} text={service.intro} photo={service.photo} shape={service.shape} crumbs={crumbs}>
    {service.soort === 'gelegenheid' ? (
      <BusFirstStep title={datumVraag[service.gelegenheid] ?? 'Wanneer is je feest?'} occasion={service.gelegenheid} />
    ) : (
      <BusFirstStep title="Waarvoor zoek je een foodtruck?" />
    )}
  </BusPageHero>
  <BusPlaces />
  <BusCases title="Hier deden we dit al" items={cases.slice(0, 6)} more />
  <BusMoments title={service.momentsTitle} items={service.moments} />
  {service.opties && service.optiesTitle
    ? <BusMoments title={service.optiesTitle} items={service.opties} theme="green" />
    : service.soort === 'mogelijkheid' && <BusRows title="Waar past dit bij?" soort="gelegenheid" theme="green" />}
  <BusStory title={service.storyTitle} paragraphs={service.story} photo={service.storyPhoto} shape="arch" flip>
    {lokaal.length > 0 && (
      <p class="service_local u-text-style-main">
        Per regio: {lokaal.map((item, index) => (
          <>{index > 0 && ', '}<a class="service_local_link" href={url(item.slug)}>{(item.kruimel ?? item.naam).replace(/^./, (c) => c.toLowerCase())}</a></>
        ))}.
      </p>
    )}
  </BusStory>
  <BusRoute />
  <BusFit occasion={service.gelegenheid} />
  <BusReviews cases={cases.map((item) => item.slug)} />
  <BusFaq items={vragen} />
  <BusClosing title="Zullen we het regelen?" occasion={service.gelegenheid} label="Check je datum" />
</BusBase>

<style>
  .service_local { margin-top: var(--_spacing---space--3); }
  .service_local_link { color: var(--_theme---text-link--text); }
</style>
