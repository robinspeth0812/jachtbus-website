---
// The page for an address that does not exist. It never ends the visit: it
// guesses from the address what someone was after, starts the request right
// here, and lists every way back into the site. Kept out of search engines,
// also after go-live.
import BusBase from '../layouts/BusBase.astro';
import BusPageHero from '../components/bus/BusPageHero.astro';
import BusFirstStep from '../components/bus/BusFirstStep.astro';
import BusButton from '../components/BusButton.astro';
import { contact, locaties, regions, services, url } from '../data/nieuw';

// Words in a broken address and the page they most likely meant, best guess first.
const guesses = [
  { href: url('catering/bruiloft'), label: 'Foodtruck op je bruiloft', words: ['bruiloft', 'trouw', 'wedding', 'huwelijk'] },
  { href: url('catering/bedrijfsfeest'), label: 'Foodtruck op je bedrijfsfeest', words: ['bedrijf', 'personeel', 'zakelijk', 'kerst', 'jubileum'] },
  { href: url('catering/tuinfeest'), label: 'Foodtruck op je tuinfeest', words: ['tuin', 'verjaardag', 'thuis', 'priv'] },
  { href: url('catering/evenement'), label: 'Foodtruck op je evenement', words: ['evenement', 'festival', 'markt', 'braderie'] },
  { href: url('catering/bbq-smoker'), label: 'BBQ van de smoker', words: ['bbq', 'barbecue', 'smoker', 'vlees'] },
  { href: url('catering/walking-dinner'), label: 'Walking dinner', words: ['walking', 'dinner', 'diner', 'gang'] },
  { href: url('agenda'), label: 'Agenda: waar staat de bus?', words: ['agenda', 'event', 'kalender', 'planning', 'waar'] },
  { href: url('referenties'), label: 'Feesten waar we stonden', words: ['referentie', 'review', 'ervaring', 'klus', 'portfolio', 'foto'] },
  { href: url('aanvraag'), label: 'Check of de bus vrij is', words: ['aanvraag', 'aanvragen', 'offerte', 'boek', 'reserve', 'prijs', 'tarief', 'kosten', 'beschikbaar'] },
  { href: url('veelgestelde-vragen'), label: 'Veelgestelde vragen', words: ['vraag', 'vragen', 'faq', 'stroom', 'regen'] },
  { href: url('over-ons'), label: 'Over Peer en de bus', words: ['over', 'peer', 'team', 'wie', 'verhaal'] },
  { href: url('contact'), label: 'Contact', words: ['contact', 'bel', 'mail', 'adres', 'route'] },
  ...locaties.map((item) => ({ href: url(item.slug), label: item.metaTitle, words: [item.slug.split('-').pop() ?? item.naam.toLowerCase()] })),
  ...regions.map((item) => ({ href: url(item.slug), label: `Foodtruck in ${item.naam}`, words: [item.naam.toLowerCase()] })),
  { href: url('catering'), label: 'Alles wat we doen', words: ['catering', 'foodtruck', 'menu', 'eten'] },
  { href: url('privacy'), label: 'Privacyverklaring', words: ['privacy', 'avg'] },
  { href: url('cookies'), label: 'Cookies', words: ['cookie'] },
  { href: url('voorwaarden'), label: 'Voorwaarden', words: ['voorwaarden', 'algemene'] },
];

const groups = [
  { title: 'Wat vier je?', links: services.filter((item) => item.soort === 'gelegenheid').map((item) => ({ href: url(`catering/${item.slug}`), label: item.nav })) },
  { title: 'Wat kunnen we koken?', links: [...services.filter((item) => item.soort === 'mogelijkheid').map((item) => ({ href: url(`catering/${item.slug}`), label: item.nav })), { href: url('catering'), label: 'Alles op een rij' }] },
  { title: 'Even rondkijken', links: [{ href: url('referenties'), label: 'Feesten waar we stonden' }, { href: url('agenda'), label: 'Agenda' }, { href: url('over-ons'), label: 'Over ons' }, { href: url('veelgestelde-vragen'), label: 'Veelgestelde vragen' }] },
  { title: 'Waar rijden we?', links: [...regions, ...locaties].map((item) => ({ href: url(item.slug), label: item.kruimel ?? `Foodtruck ${item.naam}` })) },
];
---

<BusBase
  title="Deze pagina is er niet"
  description="Deze pagina bestaat niet (meer). Kijk of de Jachtbus vrij is op jouw datum, of vind snel de juiste pagina."
  noindex
>
  <BusPageHero title="Hier staat de bus niet" text="Dit adres bestaat niet (meer). Misschien zijn we al doorgereden. Geen zorgen, je bent zo weer op de goede plek." split="even">
    <div class="lost_guess_wrap" hidden>
      <p class="lost_guess_title u-text-style-bus-title">Zocht je dit?</p>
      <ul class="lost_guess_list">
        {guesses.map((guess) => (
          <li class="lost_guess_item" data-words={guess.words.join(' ')} hidden>
            <a class="lost_guess_link u-text-style-main" href={guess.href} data-trigger="hover focus">
              {guess.label}
              <svg class="lost_guess_arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.500 8h10M8.500 3.500 13 8l-4.500 4.500" stroke="currentColor" stroke-width="2.500" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="lost_actions u-button-wrapper">
      <BusButton label="Naar de homepage" href={url()} variant="secondary" />
    </div>
    <div slot="side">
      <BusFirstStep title="Kijk meteen of de bus vrij is" direct={false} />
    </div>
  </BusPageHero>

  <section class="lost_wrap u-section u-theme-bus-beige">
    <div class="lost_contain u-container">
      <h2 class="lost_title u-text-style-poster-small">Waar ben je naar op zoek?</h2>
      <div class="lost_layout">
        {groups.map((group) => (
          <nav class="lost_group" aria-label={group.title}>
            <h3 class="lost_group_title u-text-style-bus-title">{group.title}</h3>
            <ul class="lost_list">
              {group.links.map((link) => (
                <li class="lost_item">
                  <a class="lost_link u-text-style-main" href={link.href} data-trigger="hover focus">
                    {link.label}
                    <svg class="lost_link_arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.500 8h10M8.500 3.500 13 8l-4.500 4.500" stroke="currentColor" stroke-width="2.500" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
      <div class="lost_help">
        <p class="lost_help_text u-text-style-large">Kom je er niet uit? Vraag het Peer gewoon even.</p>
        <div class="lost_help_actions u-button-wrapper">
          <BusButton label="App Peer" href={contact.whatsappHref} />
          <BusButton label={`Bel ${contact.telefoon}`} href={contact.telefoonHref} variant="secondary" />
        </div>
      </div>
    </div>
  </section>
</BusBase>

<style>
  .lost_actions,
  .lost_help_actions { justify-content: flex-start; }
  .lost_guess_wrap {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--2);
    padding: var(--_spacing---space--4) var(--_spacing---space--5);
    border-left: var(--size--stripe-thin) solid var(--color--bus-yellow);
    background-color: var(--_theme---background-2);
  }
  .lost_guess_wrap[hidden],
  .lost_guess_item[hidden] { display: none; }
  .lost_guess_list {
    display: flex;
    flex-flow: column;
  }
  .lost_guess_link,
  .lost_link {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
    min-height: var(--target--min);
    color: inherit;
    font-weight: var(--_typography---font--primary-bold);
    text-decoration: underline;
    text-underline-offset: var(--_spacing---space--1);
  }
  .lost_guess_arrow,
  .lost_link_arrow {
    flex: 0 0 auto;
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
    transform: translateX(calc(var(--_spacing---space--1) * var(--_trigger---off)));
  }
  .lost_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .lost_contain {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--6);
  }
  .lost_layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size--nav-card)), 1fr));
    gap: var(--_spacing---space--6) var(--site--gutter);
  }
  .lost_group {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--2);
    padding-top: var(--_spacing---space--3);
    border-top: var(--focus--width) solid var(--_theme---border);
  }
  .lost_list {
    display: flex;
    flex-flow: column;
  }
  .lost_link { color: var(--_theme---text-link--text); }
  .lost_help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--_spacing---space--4);
    padding: var(--_spacing---space--5);
    background-color: var(--_theme---background-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lost_guess_arrow,
    .lost_link_arrow { transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1); }
  }
</style>

<script>
  // Guess from the broken address what someone was after: the words in the
  // path against the words of each page, at most two matches, best first.
  const wrap = document.querySelector<HTMLElement>('.lost_guess_wrap');
  if (wrap) {
    const path = decodeURIComponent(window.location.pathname).toLowerCase();
    const hits = [...wrap.querySelectorAll<HTMLElement>('.lost_guess_item')]
      .filter((item) => (item.dataset.words ?? '').split(' ').some((word) => word && path.includes(word)))
      .filter((item, index, all) => all.findIndex((other) => other.querySelector('a')?.getAttribute('href') === item.querySelector('a')?.getAttribute('href')) === index)
      .slice(0, 2);
    hits.forEach((item) => (item.hidden = false));
    wrap.hidden = hits.length === 0;
  }
  // So broken links show up in the statistics; only runs after a yes for cookies.
  window.gtag?.('event', 'page_not_found', { page_path: window.location.pathname, page_referrer: document.referrer });
</script>
