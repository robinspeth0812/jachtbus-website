---
// Home of the new site. The hero slider is the only thing that moves on its
// own, everything after that moves with the visitor's scroll.
import BusBase from '../../layouts/BusBase.astro';
import BusButton from '../../components/BusButton.astro';
import BusDateCheck from '../../components/bus/BusDateCheck.astro';
import BusSlider from '../../components/bus/BusSlider.astro';
import BusPlaces from '../../components/bus/BusPlaces.astro';
import BusRows from '../../components/bus/BusRows.astro';
import BusStory from '../../components/bus/BusStory.astro';
import BusRoute from '../../components/bus/BusRoute.astro';
import BusMenu from '../../components/bus/BusMenu.astro';
import BusQuote from '../../components/bus/BusQuote.astro';
import BusFit from '../../components/bus/BusFit.astro';
import BusReviews from '../../components/bus/BusReviews.astro';
import BusFaq from '../../components/bus/BusFaq.astro';
import BusClosing from '../../components/bus/BusClosing.astro';
import { contact, photos, url, values } from '../../data/nieuw';
import { getInhoud } from '../../lib/cms';
import sideImg from '../../assets/ambachtelijk-eten.jpg';
import { faqSchema } from '../../lib/schema';

const { faq } = await getInhoud();
const faqItems = faq.slice(0, 6);
---

<BusBase
  title="Foodtruck huren in Noord-Nederland"
  description="De Jachtbus komt naar je feest en kookt ter plekke. Voor bruiloften, tuinfeesten, bedrijfsfeesten en evenementen in Noord-Nederland, vanaf 40 personen."
  schema={[faqSchema(faqItems)]}
>
  <section class="home-hero_wrap u-theme-bus-green">
    <div class="home-hero_contain u-container">
      <div class="home-hero_layout">
        <h1 class="home-hero_title u-text-style-poster">Zet ons neer, wij koken.</h1>
        <div class="home-hero_content">
          <p class="home-hero_text u-text-style-large">
            We rijden naar je tuin, je bedrijf of je weiland, zetten de luiken open
            en koken ter plekke. In Drenthe, Groningen en Friesland.
          </p>
          <BusDateCheck />
          <p class="home-hero_call u-text-style-small">
            Of bel Peer op <a class="home-hero_link" href={contact.telefoonHref}>{contact.telefoon}</a>. Vanaf 40 personen.
          </p>
        </div>
      </div>
    </div>
    <div class="home-hero_visual">
      <BusSlider
        eager
        slides={[
          { photo: photos.luik, focus: '50% 62%' },
          { photo: photos.bus },
          { photo: photos.plank },
          { photo: photos.veld, focus: '30% 50%' },
          { photo: photos.grill, focus: '60% 50%' },
          { photo: photos.smoker },
        ]}
      />
    </div>
  </section>

  <section class="home-proof_wrap u-section u-theme-bus-black" aria-labelledby="home-proof-title">
    <div class="home-proof_contain u-container">
      <h2 class="home-proof_title u-text-style-poster-small" id="home-proof-title">
        In augustus 2025 reden we voor het eerst uit. In 2026 stonden we al op zo’n 40 feesten.
      </h2>
    </div>
  </section>
  <BusPlaces />

  <BusRows />

  <BusStory
    title="Wat op de bus staat, doen we ook"
    photo={{ src: sideImg, alt: 'De zijkant van de bus, met de woorden lokaal verkregen, eerlijke producten en ambachtelijk bereid' }}
    shape="corner"
    theme="green"
    focus="60% 50%"
  >
    <ul class="home-values_list">
      {values.map((value) => (
        <li class="home-values_item">
          <h3 class="home-values_name u-text-style-poster-label">{value.title}</h3>
          <p class="home-values_text u-text-style-main">{value.text}</p>
        </li>
      ))}
    </ul>
  </BusStory>

  <BusMenu />
  <BusRoute />
  <BusQuote />
  <BusFit />
  <BusReviews />
  <BusFaq items={faqItems} />
  <section class="home-more_wrap u-theme-bus-beige">
    <div class="home-more_contain u-container">
      <BusButton label="Alle vragen" href={url('veelgestelde-vragen')} variant="secondary" />
    </div>
  </section>
  <BusClosing />
</BusBase>

<style>
  .home-hero_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .home-hero_layout {
    display: var(--flex-medium, grid);
    flex-direction: column;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: var(--start-medium, end);
    gap: var(--_spacing---space--5) var(--site--gutter);
    /* Clears the logo that hangs out of the bar. */
    padding-top: calc(var(--size--nav-logo-now) - var(--size--nav-bar) + var(--_spacing---space--6));
    padding-bottom: var(--_spacing---space--7);
  }
  .home-hero_title {
    grid-column: 1 / span 6;
    max-width: 11ch;
  }
  .home-hero_content {
    grid-column: 7 / span 6;
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--4);
    width: 100%;
  }
  .home-hero_text { max-width: 52ch; }
  .home-hero_link { color: var(--_theme---text-link--text); }

  .home-hero_visual { padding-bottom: var(--_spacing---space--7); }

  .home-proof_wrap {
    padding-bottom: var(--_spacing---space--5);
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .home-proof_title { max-width: 28ch; }

  .home-values_item {
    padding-block: var(--_spacing---space--3);
    border-top: var(--focus--width) solid var(--color--bus-yellow);
  }
  .home-values_name { margin-bottom: var(--_spacing---space--1); }

  .home-more_wrap {
    padding-bottom: var(--_spacing---space--7);
    background-color: var(--_theme---background);
  }
  .home-more_contain { align-items: flex-start; }
</style>
