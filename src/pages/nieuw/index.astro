---
// Home of the new site, in the order of the home page outline: the first step
// of the form right in view, then whatever takes away the doubt, and the form
// again at the end. The hero slider is the only thing that moves on its own.
import BusBase from '../../layouts/BusBase.astro';
import BusButton from '../../components/BusButton.astro';
import BusFirstStep from '../../components/bus/BusFirstStep.astro';
import BusSlider from '../../components/bus/BusSlider.astro';
import BusMoments from '../../components/bus/BusMoments.astro';
import BusMap from '../../components/bus/BusMap.astro';
import BusValues from '../../components/bus/BusValues.astro';
import BusRows from '../../components/bus/BusRows.astro';
import BusStory from '../../components/bus/BusStory.astro';
import BusRoute from '../../components/bus/BusRoute.astro';
import BusFit from '../../components/bus/BusFit.astro';
import BusReviews from '../../components/bus/BusReviews.astro';
import BusFaq from '../../components/bus/BusFaq.astro';
import BusClosing from '../../components/bus/BusClosing.astro';
import { aanvraagUrl, photos, twijfels, url, waarom } from '../../data/nieuw';
import { getInhoud } from '../../lib/cms';
import sideImg from '../../assets/ambachtelijk-eten.jpg';
import { faqSchema } from '../../lib/schema';

const { faq } = await getInhoud();
const faqItems = faq.slice(0, 6);
---

<BusBase
  title="Foodtruck huren in Noord-Nederland"
  description="De Jachtbus komt naar je feest en kookt ter plekke. Voor bruiloften, tuinfeesten, bedrijfsfeesten en evenementen in Noord-Nederland, vanaf 40 personen."
  schema={[faqSchema(faqItems)]}
>
  <section class="home-hero_wrap u-theme-bus-green">
    <div class="home-hero_contain u-container">
      <div class="home-hero_layout">
        <div class="home-hero_intro">
          <h1 class="home-hero_label u-text-style-main">Mobiele cateraar/foodtruck in Drenthe, Friesland, Groningen e.o.</h1>
          <h2 class="home-hero_title u-text-style-poster">Eerlijk, ambachtelijk bereid eten op locatie</h2>
          <p class="home-hero_text u-text-style-large">
            Eerlijke catering, vers bereid en zorgvuldig samengesteld. Op jouw locatie in
            <a class="home-hero_link" href={url('foodtruck-drenthe')}>Drenthe</a>,
            <a class="home-hero_link" href={url('foodtruck-groningen')}>Groningen</a> of
            <a class="home-hero_link" href={url('foodtruck-friesland')}>Friesland</a>
            met de Jachtbus Foodtruck.
          </p>
          <div class="home-hero_cta u-button-wrapper">
            <BusButton label="Start je aanvraag" href={aanvraagUrl()} />
          </div>
        </div>
        <div class="home-hero_form">
          <BusFirstStep title="Waarvoor zoek je een foodtruck?" />
        </div>
      </div>
    </div>
    <div class="home-hero_visual">
      <BusSlider
        eager
        slides={[
          { photo: photos.luik, focus: '50% 62%' },
          { photo: photos.bus },
          { photo: photos.plank },
          { photo: photos.veld, focus: '30% 50%' },
          { photo: photos.grill, focus: '60% 50%' },
          { photo: photos.smoker },
        ]}
      />
    </div>
  </section>

  <BusValues />

  <BusMoments title="Op zoek naar écht goede foodtruckcatering?" items={twijfels} />


  <BusRows title="Waar staat de Jachtbus straks?" soort="gelegenheid" theme="green">
    <div class="home-rows_more">
      <BusButton label="Bekijk al onze catering" href={url('catering')} arrow />
    </div>
  </BusRows>

  <BusRoute />

  <BusStory
    title="Waarom de Jachtbus?"
    photo={{ src: sideImg, alt: 'De zijkant van de bus, met de woorden lokaal verkregen, eerlijke producten en ambachtelijk bereid' }}
    shape="corner"
    theme="green"
    focus="60% 50%"
  >
    <ul class="home-values_list">
      {waarom.map((value) => (
        <li class="home-values_item">
          <h3 class="home-values_name u-text-style-poster-label">{value.title}</h3>
          <p class="home-values_text u-text-style-main">{value.text}</p>
        </li>
      ))}
    </ul>
  </BusStory>

  <BusMap />
  <BusReviews />

  <BusFit />
  <BusFaq items={faqItems} />
  <section class="home-more_wrap u-theme-bus-beige">
    <div class="home-more_contain u-container">
      <BusButton label="Alle vragen" href={url('veelgestelde-vragen')} variant="secondary" />
    </div>
  </section>
  <BusClosing text="Kies wat je viert, dan vragen we alleen nog wat we echt moeten weten. Een richtdatum en een schatting van het aantal gasten is genoeg." />
</BusBase>

<style>
  .home-hero_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .home-hero_layout {
    display: var(--flex-medium, grid);
    flex-direction: column;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    gap: var(--_spacing---space--5) var(--site--gutter);
    /* Clears the logo that hangs out of the bar. */
    padding-top: calc(var(--size--nav-logo-now) - var(--size--nav-bar) + var(--_spacing---space--6));
    padding-bottom: var(--_spacing---space--7);
  }
  .home-hero_intro {
    grid-column: 1 / span 6;
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--4);
    width: 100%;
  }
  .home-hero_label {
    font-weight: var(--_typography---font--primary-bold);
    text-transform: none;
    /* The capitals line up with the top of the form block. */
    text-box: trim-start cap alphabetic;
  }
  .home-hero_title {
    max-width: 17ch;
    font-size: var(--_typography---size--poster-hero);
  }
  /* On phones the button opens the form, wider the first step is on the page. */
  .home-hero_cta {
    display: var(--flex-medium, none);
    justify-content: flex-start;
  }
  .home-hero_text { max-width: 44ch; }
  .home-hero_link { color: inherit; }
  /* Next to the text the block takes no height, so the text sets where the
     photos start and the block lies over them. */
  .home-hero_form {
    grid-column: 7 / span 6;
    position: relative;
    z-index: 1;
    display: var(--none-medium, block);
    width: 100%;
    height: 0;
  }
  .home-hero_visual { padding-bottom: var(--_spacing---space--7); }

  .home-rows_more { margin-top: var(--_spacing---space--5); }

  .home-values_item {
    padding-block: var(--_spacing---space--3);
    border-top: var(--border-width--main) solid var(--_theme---divider);
  }
  .home-values_name { margin-bottom: var(--_spacing---space--1); }

  .home-more_wrap {
    padding-bottom: var(--_spacing---space--7);
    background-color: var(--_theme---background);
  }
  .home-more_contain { align-items: flex-start; }
</style>
