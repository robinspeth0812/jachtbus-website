---
// Where the bus stands: first the public events of the coming month, then the
// full agenda with private bookings as a date only. Peer keeps it up to date in
// the portal; a nightly build takes what is over off the page.
import BusBase from '../../layouts/BusBase.astro';
import BusPageHero from '../../components/bus/BusPageHero.astro';
import BusEventSlider from '../../components/bus/BusEventSlider.astro';
import BusAgenda from '../../components/bus/BusAgenda.astro';
import BusClosing from '../../components/bus/BusClosing.astro';
import { photos, url } from '../../data/nieuw';
import { getInhoud } from '../../lib/cms';

const { evenementen } = await getInhoud();
const crumbs = [{ label: 'Agenda', href: url('agenda') }];
const site = 'https://jachtbusfoodtruck.nl';

// Public events only, never bookings. Only fields that are really known; no invented prices or organisers.
const eventSchema = evenementen.map((item) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: item.titel,
  startDate: item.vanTijd ? `${item.datum}T${item.vanTijd}` : item.datum,
  ...(item.totDatum || item.totTijd ? { endDate: item.totTijd ? `${item.totDatum ?? item.datum}T${item.totTijd}` : item.totDatum } : {}),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: item.locatie ?? item.plaats, address: { '@type': 'PostalAddress', addressLocality: item.plaats, addressCountry: 'NL' } },
  ...(item.tekst ? { description: item.tekst } : {}),
  ...(item.fotoUrl ? { image: item.fotoUrl } : {}),
  ...(item.linkUrl ? { url: item.linkUrl.startsWith('/') ? `${site}${item.linkUrl}` : item.linkUrl } : {}),
  performer: { '@id': `${site}/#business` },
}));
---

<BusBase
  title="Agenda: waar staat de Jachtbus?"
  description="Markten, festivals en open dagen in Drenthe, Groningen en Friesland waar je zonder reservering bij de Jachtbus komt eten."
  crumbs={crumbs}
  schema={eventSchema}
>
  <BusPageHero
    title="Waar staat de bus?"
    text="Op markten, festivals en open dagen kun je gewoon langskomen en een hapje halen. En je ziet welke dagen de bus al geboekt is."
    photo={photos.festival}
    shape="arch"
    crumbs={crumbs}
  />

  <BusEventSlider title="Binnenkort: kom langs" />
  <BusAgenda />

  <BusClosing title="Liever de bus op je eigen feest?" />
</BusBase>
