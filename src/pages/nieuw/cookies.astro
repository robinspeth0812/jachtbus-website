---
// Cookie policy, built from the same list as the banner (src/data/cookies.ts).
// Keep the words here in step with what the site really does.
import BusBase from '../../layouts/BusBase.astro';
import BusPageHero from '../../components/bus/BusPageHero.astro';
import BusCookieDetails from '../../components/bus/BusCookieDetails.astro';
import { cookieGroups } from '../../data/cookies';
import { url } from '../../data/nieuw';

const crumbs = [{ label: 'Cookiebeleid', href: url('cookies') }];
---

<BusBase title="Cookiebeleid" description="Welke cookies en diensten jachtbusfoodtruck.nl gebruikt, waar we toestemming voor vragen en hoe je je keuze aanpast." crumbs={crumbs}>
  <BusPageHero title="Cookiebeleid" text="Wat we gebruiken, waarvoor, en hoe je het aanpast. Laatst bijgewerkt: november 2026." crumbs={crumbs} />
  <section class="legal_wrap u-section u-theme-bus-beige">
    <div class="legal_contain u-container">
      <div class="legal_layout u-margin-trim">
        <h2 class="legal_title u-text-style-poster-label">Hoe het werkt</h2>
        <p class="legal_text u-text-style-main">
          Wat nodig is om de site te laten werken, staat altijd aan. Al het andere
          staat uit tot jij ja zegt. Weigeren is net zo makkelijk als accepteren, en
          de site werkt dan gewoon. Na 12 maanden vragen we het opnieuw. Meer over je
          gegevens lees je in onze <a class="legal_link" href={url('privacy')}>privacyverklaring</a>.
        </p>

        <h2 class="legal_title u-text-style-poster-label">Je keuze aanpassen</h2>
        <p class="legal_text u-text-style-main">
          Je past je keuze hier aan, of via Cookie-instellingen onder aan elke pagina.
          Trek je een ja in, dan stoppen we meteen en halen we die cookies weg. Je kunt
          cookies ook altijd zelf wissen via de instellingen van je browser.
        </p>
        <button class="legal_button" type="button" data-consent-open data-trigger="hover focus">Cookie-instellingen</button>

        {cookieGroups.map((group) => (
          <>
            <h2 class="legal_title u-text-style-poster-label">{group.naam}</h2>
            <p class="legal_text u-text-style-main">{group.tekst}</p>
            {group.diensten.map((dienst) => <BusCookieDetails service={dienst} />)}
          </>
        ))}

        <h2 class="legal_title u-text-style-poster-label">Externe links</h2>
        <p class="legal_text u-text-style-main">
          Klik je door naar WhatsApp, Instagram, Facebook of Google, dan gelden daar
          de cookies en voorwaarden van die platforms. Dat begint pas zodra je klikt.
        </p>

        <h2 class="legal_title u-text-style-poster-label">Als dit verandert</h2>
        <p class="legal_text u-text-style-main">
          Gebruiken we iets nieuws, dan zetten we het hier en vragen we je opnieuw om
          je keuze voordat het aan gaat.
        </p>
      </div>
    </div>
  </section>
</BusBase>

<style>
  .legal_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .legal_layout {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--3);
    max-width: var(--max-width--small);
  }
  .legal_title { margin-top: var(--_spacing---space--5); }
  .legal_text { max-width: 70ch; }
  .legal_link { color: var(--_theme---text-link--text); }
  .legal_button {
    align-self: flex-start;
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--4);
    background-color: color-mix(in hsl, var(--color--bus-green) calc(100% * var(--_trigger---on)), var(--color--bus-black) calc(100% * var(--_trigger---off)));
    color: var(--color--white);
    border: none;
    font-family: var(--_typography---font--heading);
    font-stretch: var(--_typography---stretch--poster);
    font-weight: var(--_typography---font--primary-bold);
    cursor: pointer;
  }
</style>
