---
import BusBase from '../../../layouts/BusBase.astro';
import BusPageHero from '../../../components/bus/BusPageHero.astro';
import BusRows from '../../../components/bus/BusRows.astro';
import BusMenu from '../../../components/bus/BusMenu.astro';
import BusRoute from '../../../components/bus/BusRoute.astro';
import BusFit from '../../../components/bus/BusFit.astro';
import BusFaq from '../../../components/bus/BusFaq.astro';
import BusClosing from '../../../components/bus/BusClosing.astro';
import { faqAlgemeen, photos, url } from '../../../data/nieuw';
import { faqSchema, serviceSchema } from '../../../lib/schema';

const description = 'Foodtruckcatering op locatie voor bruiloften, tuinfeesten, bedrijfsfeesten en evenementen. Alles ter plekke bereid, in Drenthe, Groningen en Friesland.';
const crumbs = [{ label: 'Catering', href: url('catering') }];
const faqItems = faqAlgemeen.slice(0, 4);
---

<BusBase
  title="Foodtruckcatering op locatie"
  description={description}
  crumbs={crumbs}
  schema={[serviceSchema('Foodtruckcatering', description), faqSchema(faqItems)]}
>
  <BusPageHero
    title="De keuken komt naar jou toe"
    text="Geen zaal nodig, geen keuken nodig. Wij nemen alles mee, koken ter plekke en laten het netjes achter."
    photo={photos.bus}
    shape="corner"
    crumbs={crumbs}
    checkLabel="Check je datum"
  />
  <BusRows title="Waar komen we voor?" soort="gelegenheid" />
  <BusRows title="En wat kan er allemaal?" soort="mogelijkheid" theme="green" />
  <BusMenu />
  <BusRoute />
  <BusFit />
  <BusFaq items={faqItems} />
  <BusClosing />
</BusBase>
