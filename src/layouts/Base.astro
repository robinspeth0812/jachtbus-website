---
import '@fontsource-variable/asap';
import '@fontsource-variable/open-sans';
import '@fontsource/nothing-you-could-do';
import '../styles/tokens.css';
import '../styles/lumos.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import CtaBar from '../components/CtaBar.astro';

interface Props {
  /** Page title shown in the browser tab and search results. */
  title: string;
  /** Meta description for search engines. */
  description?: string;
  /** Keep this page out of search engines (internal pages like the style guide). */
  noindex?: boolean;
  /** Show the thin CTA bar above the footer; turn off on pages with their own closing CTA. */
  footerCta?: boolean;
}

const { title, description = '', noindex = false, footerCta = true } = Astro.props;

// Site-wide noindex until launch (owner's call): the site may deploy
// but not be indexed yet. Flip to false at go-live.
const SITE_NOINDEX = true;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// No sticky request-CTA on the request page itself.
const showCtaBar = !Astro.url.pathname.startsWith('/aanvraag');

// LocalBusiness structured data (service-area business): the schema
// confirms who we are and WHERE we work. Deliberately no aggregateRating -
// never invented numbers - and no image until the real photos arrive.
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  '@id': 'https://jachtbusfoodtruck.nl/#business',
  name: 'Jachtbus Foodtruck',
  legalName: 'Jachtbus Foodtruck & Catering B.V.',
  identifier: { '@type': 'PropertyValue', propertyID: 'KVK', value: '96772174' },
  url: 'https://jachtbusfoodtruck.nl',
  telephone: '+31592656363',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Julianalaan 54',
    postalCode: '9462 PH',
    addressLocality: 'Gasselte',
    addressRegion: 'Drenthe',
    addressCountry: 'NL',
  },
  areaServed: [
    { '@type': 'State', name: 'Drenthe' },
    { '@type': 'State', name: 'Groningen' },
    { '@type': 'State', name: 'Friesland' },
    { '@type': 'City', name: 'Assen' },
    { '@type': 'City', name: 'Groningen' },
    { '@type': 'City', name: 'Leeuwarden' },
    { '@type': 'City', name: 'Roden' },
    { '@type': 'City', name: 'Emmen' },
    { '@type': 'City', name: 'Meppel' },
    { '@type': 'City', name: 'Drachten' },
    { '@type': 'City', name: 'Hoogeveen' },
  ],
  sameAs: [
    'https://www.instagram.com/jachtbusfoodtruck/',
    'https://www.facebook.com/brasseriejachtlust',
  ],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Jachtbus Foodtruck</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {(noindex || SITE_NOINDEX) && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} is:inline />

  </head>
  <body>
    <a class="skip_wrap" href="#main">Direct naar de inhoud</a>
    <Nav />
    <main id="main" class="main_wrap">
      <slot />
    </main>
    <Footer showCta={footerCta} />
    <WhatsappButton />
    {showCtaBar && <CtaBar />}
  </body>
</html>

<style>
  .skip_wrap {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    padding: var(--_spacing---space--3) var(--_spacing---space--5);
    background-color: var(--_theme---background);
    color: var(--_theme---text);
    transform: translateY(-100%);
  }
  .skip_wrap:focus-visible { transform: translateY(0); }
  .main_wrap {
    display: flex;
    flex-flow: column;
  }
</style>
