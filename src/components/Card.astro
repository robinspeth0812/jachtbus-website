---
// Generic card: optional photo on top (fixed aspect so headings line up
// across a row), a heading (h2 or h3), an optional paragraph, and an
// optional stacked block-link list for quick internal navigation.
// Give either `links` (block links inside the card) or `href` (the
// whole card becomes one link), not both.
import { Image } from 'astro:assets';

interface CardLink {
  /** Where the link goes. */
  href: string;
  /** Link label. */
  label: string;
}
interface Props {
  /** Card heading. */
  title: string;
  /** Heading level: 3 inside a section with its own h2, else 2. */
  headingLevel?: 2 | 3;
  /** Optional photo on top of the card. */
  image?: ImageMetadata;
  /** Alt text for the photo; keep empty when decorative. */
  alt?: string;
  /** Optional paragraph under the heading. */
  text?: string;
  /** Optional stacked block links at the bottom of the card. */
  links?: CardLink[];
  /** Makes the whole card one link; ignored when links are given. */
  href?: string;
}
const {
  title,
  headingLevel = 3,
  image = undefined,
  alt = '',
  text = '',
  links = [],
  href = '',
} = Astro.props;

const Heading = headingLevel === 2 ? 'h2' : 'h3';
const isLinkCard = href !== '' && links.length === 0;
const Wrap = isLinkCard ? 'a' : 'div';
---

<Wrap
  class="card_wrap"
  href={isLinkCard ? href : undefined}
  data-trigger={isLinkCard ? 'hover focus' : undefined}
>
  {
    image && (
      <span class="card_visual">
        <Image class="card_img" src={image} alt={alt} width={640} />
      </span>
    )
  }
  <span class="card_body u-margin-trim">
    <Heading class="card_title u-text-style-h4">
      {isLinkCard ? <span class="card_title_text u-hover-underline">{title}</span> : title}
    </Heading>
    {text && <span class="card_text u-text-style-main">{text}</span>}
  </span>
  {
    links.length > 0 && (
      <ul class="card_links">
        {links.map((link) => (
          <li class="card_links_item">
            <a class="card_link_wrap" href={link.href} data-trigger="hover focus">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Wrap>

<style>
  .card_wrap {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: var(--_theme---background-2);
    border: var(--border-width--main) solid var(--_theme---border);
    border-radius: var(--radius--large);
    overflow: clip;
    text-decoration: none;
  }
  .card_visual {
    display: block;
    overflow: clip;
    flex-shrink: 0;
  }
  .card_img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transform: scale(calc(1 + 0.04 * var(--_trigger---off)));
    transition: transform 300ms;
  }
  .card_body {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--2);
    flex-grow: 1;
    padding: var(--_spacing---space--4) var(--_spacing---space--5) var(--_spacing---space--5);
  }
  .card_text {
    display: block;
    max-width: 40ch;
  }
  /* Stacked block links, pinned to the card bottom so lists line up
     across a row of cards. */
  .card_links {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }
  .card_links_item {
    display: flex;
    border-top: var(--border-width--main) solid var(--_theme---border);
  }
  .card_link_wrap {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: var(--target--min);
    padding: var(--_spacing---space--2) var(--_spacing---space--5);
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
    font-size: var(--_typography---size--small);
    text-decoration: none;
    background-color: color-mix(
      in srgb,
      transparent calc(100% * var(--_trigger---on)),
      var(--_theme---border) calc(100% * var(--_trigger---off))
    );
    transition: background-color 300ms;
  }
</style>
