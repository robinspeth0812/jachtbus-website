---
// Two-column step flow: intro column left (sticky on desktop) with
// heading, paragraph, a chat bubble from Peer, and the request button;
// numbered steps right, without a connecting line. The closing line
// under the steps is deliberately not a numbered step.
import Button from './Button.astro';
import ChatBubble from './ChatBubble.astro';

interface Step {
  /** Step heading. */
  title: string;
  /** Short explanation. */
  text: string;
}
interface Props {
  /** Section heading. */
  title?: string;
  /** Paragraph under the heading. */
  text?: string;
  /** Chat bubble message from Peer in the intro column. */
  bubbleMessage?: string;
  /** Label on the request button; empty hides the button. */
  buttonLabel?: string;
  /** Where the request button links to. */
  buttonHref?: string;
  /** The numbered steps. */
  steps?: Step[];
  /** Closing line under the steps; empty hides it. */
  closing?: string;
  /** Section theme. */
  theme?: 'light' | 'soft' | 'brand';
}
const {
  title = "Hoe gaat dat eigenlijk in z'n werk?",
  text = 'Nou, heel makkelijk, van aanvraag tot afspraak wordt alles soepel geregeld.',
  bubbleMessage = 'En als je vragen hebt tussendoor, ben ik één appje van je vandaan!',
  buttonLabel = '',
  buttonHref = '/aanvraag',
  steps = [
    {
      title: 'Je doet een aanvraag',
      text: 'Via ons aanvraagformulier, een WhatsAppje, een telefoontje samen. Je laat ons je situatie en wensen weten.',
    },
    {
      title: 'Samen gaan we vormgeven',
      text: 'In persoon of in een online meeting bespreken we alles wat er nodig is om er een geslaagde samenwerking van te maken.',
    },
    {
      title: 'Je krijgt een voorstel',
      text: 'Op basis van je wensen en alles wat er bij komt kijken, maken we een voorstel. Jij kijkt er naar en we passen waar nodig nog wat aan.',
    },
    {
      title: 'Wij gaan aan de slag',
      text: 'We treffen voorbereidingen naar alles wat we in het geaccepteerde voorstel hebben afgesproken. Zo is alles klaar voor een geslaagde samenwerking!',
    },
  ],
  closing = 'We zien elkaar op de afgesproken dag en tijd!',
  theme = 'light',
} = Astro.props;
const themeClass = {
  light: 'u-theme-light',
  soft: 'u-theme-soft',
  brand: 'u-theme-brand',
}[theme];
---

<section class:list={['step-flow_wrap', 'u-section', themeClass]}>
  <div class="step-flow_contain u-container">
    <div class="step-flow_layout">
      <div class="step-flow_intro u-margin-trim">
        <div class="step-flow_title u-heading u-text-style-h2">
          <h2>{title}</h2>
        </div>
        <div class="step-flow_text u-text u-text-style-large">
          <p>{text}</p>
        </div>
        {bubbleMessage && <ChatBubble message={bubbleMessage} />}
        {
          buttonLabel && (
            <div class="step-flow_actions u-button-wrapper">
              <Button variant="primary" label={buttonLabel} href={buttonHref} />
            </div>
          )
        }
      </div>
      <div class="step-flow_steps">
        <ol class="step-flow_list">
          {
            steps.map((step, index) => (
              <li class="step-flow_item">
                <span class="step-flow_item_num u-text-style-h6" aria-hidden="true">
                  {index + 1}
                </span>
                <div class="step-flow_item_content u-margin-trim">
                  <h3 class="step-flow_item_title u-text-style-h5">{step.title}</h3>
                  <p class="step-flow_item_text u-text-style-main">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        {
          closing && (
            <div class="step-flow_closing">
              <svg class="step-flow_closing_icon" aria-hidden="true" viewBox="0 0 16 16" fill="none">
                <path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p class="step-flow_closing_text u-text-style-main">{closing}</p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .step-flow_layout {
    display: var(--flex-medium, grid);
    flex-direction: column;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--_spacing---space--7) var(--_spacing---space--8);
  }
  /* The intro scrolls along on desktop while the steps pass by. */
  .step-flow_intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--_spacing---space--4);
    position: var(--relative-medium, sticky);
    top: calc((var(--nav--height-total) + var(--_spacing---space--5)) * var(--_responsive---large));
  }
  .step-flow_title {
    display: flex;
    max-width: 100%;
  }
  .step-flow_text {
    display: flex;
    max-width: 45ch;
  }
  .step-flow_steps {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--6);
  }
  .step-flow_list {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--6);
  }
  .step-flow_item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--_spacing---space--4);
    align-items: start;
  }
  .step-flow_item_num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--_spacing---space--6);
    height: var(--_spacing---space--6);
    background-color: var(--_theme---background-2);
    border: var(--border-width--main) solid var(--_theme---border);
    border-radius: var(--radius--round);
  }
  .step-flow_item_content {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--2);
  }
  .step-flow_item_text { max-width: 45ch; }
  .step-flow_closing {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--_spacing---space--4);
    align-items: center;
  }
  .step-flow_closing_icon {
    width: var(--_spacing---space--6);
    height: var(--_spacing---space--5);
    color: var(--_theme---text-accent);
  }
  .step-flow_closing_text {
    font-weight: var(--_typography---font--primary-bold);
    max-width: 45ch;
  }
</style>
