---
// The four service entrances, built on the shared Card standard: each
// tile is a whole-card link with photo, title, and one line.
import CardGrid from './CardGrid.astro';
import bruiloftImg from '../assets/dienst-bruiloft.jpg';
import bedrijfsfeestImg from '../assets/dienst-bedrijfsfeest.jpg';
import evenementImg from '../assets/dienst-evenement.jpg';
import bbqImg from '../assets/ambachtelijk-eten.jpg';

interface Props {
  /** Section heading. */
  title: string;
  /** Optional intro under the heading. */
  text?: string;
  /** Section theme. */
  theme?: 'light' | 'soft' | 'brand';
}
const { title, text = '', theme = 'light' } = Astro.props;

const services = [
  {
    href: '/catering/bruiloft',
    title: 'Bruiloft',
    text: 'Van borrel tot avondsnack, afgestemd op jullie dag.',
    image: bruiloftImg,
  },
  {
    href: '/catering/bedrijfsfeest',
    title: 'Bedrijfsfeest',
    text: 'Personeelsfeest, jubileum of borrel: wij regelen het eten.',
    image: bedrijfsfeestImg,
  },
  {
    href: '/catering/evenement',
    title: 'Evenement',
    text: 'Festival, markt of open dag, de bus draait door.',
    image: evenementImg,
  },
  {
    href: '/catering/bbq-smoker',
    title: 'BBQ-smoker',
    text: 'Langzaam gegaard vlees, salades en huisgemaakte sauzen.',
    image: bbqImg,
  },
];
---

<CardGrid title={title} text={text} theme={theme} cards={services} />
