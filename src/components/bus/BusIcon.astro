---
// The bus from the side, drawn small: green cabin, dark panel with yellow
// lines, yellow roof stripe. Decorative.

interface Props {
  /** Direction of travel. */
  facing?: 'left' | 'right';
}
const { facing = 'left' } = Astro.props;
---

<svg class:list={['bus-icon_svg', `is-${facing}`]} viewBox="0 0 96 48" aria-hidden="true">
  <rect class="bus-icon_green" x="0" y="12" width="26" height="28" />
  <rect class="bus-icon_glass" x="4" y="16" width="16" height="11" />
  <rect class="bus-icon_panel" x="24" y="3" width="72" height="37" />
  <rect class="bus-icon_yellow" x="24" y="3" width="72" height="4" />
  <path class="bus-icon_line" d="M32 40V26a10 10 0 0 1 20 0v14M58 12h30M58 18h30M58 24h30M58 30l15 10 15-10" />
  <circle class="bus-icon_wheel" cx="14" cy="40" r="7" />
  <circle class="bus-icon_wheel" cx="78" cy="40" r="7" />
</svg>

<style>
  .bus-icon_svg { display: block; width: 100%; height: auto; overflow: visible; }
  .bus-icon_svg.is-right { transform: scaleX(-1); }
  .bus-icon_green { fill: var(--color--bus-green); }
  .bus-icon_glass { fill: var(--color--marigold-1); }
  .bus-icon_panel { fill: var(--color--bus-green-dark); stroke: var(--color--bus-yellow); stroke-width: 1; }
  .bus-icon_yellow { fill: var(--color--bus-yellow); }
  .bus-icon_line { fill: none; stroke: var(--color--bus-yellow); stroke-width: 2; }
  .bus-icon_wheel { fill: var(--color--bus-green-dark); stroke: var(--color--marigold-1); stroke-width: 2; }
</style>
