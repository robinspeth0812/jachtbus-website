---
// Phones keep the three ways to reach us under the thumb.
import { Image } from 'astro:assets';
import whatsappIcon from '../../assets/whatsapp-icon.svg';
import { aanvraagUrl, contact } from '../../data/nieuw';
---

<nav class="bus-bar_wrap u-theme-bus-green" aria-label="Direct contact">
  <a class="bus-bar_link" href={contact.telefoonHref}><svg class="bus-bar_icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.600 10.800a15.100 15.100 0 0 0 6.600 6.600l2.200-2.200a1 1 0 0 1 1-.25 11.400 11.400 0 0 0 3.600.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.500a1 1 0 0 1 1 1c0 1.250.2 2.450.57 3.570a1 1 0 0 1-.25 1z" fill="currentColor" /></svg>Bellen</a>
  <a class="bus-bar_link" href={contact.whatsappHref} rel="external"><Image class="bus-bar_icon" src={whatsappIcon} alt="" width={20} height={20} />WhatsApp</a>
  <a class="bus-bar_link is-primary" href={aanvraagUrl()}>Check je datum</a>
</nav>

<style>
  .bus-bar_wrap {
    display: var(--flex-medium, none);
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    background-color: var(--_theme---background-2);
    border-top: var(--size--stripe-thin) solid var(--color--bus-yellow);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .bus-bar_link {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    gap: var(--_spacing---space--1);
    min-height: var(--size--mobile-bar);
    padding-inline: var(--_spacing---space--2);
    white-space: nowrap;
    font-family: var(--_typography---font--heading);
    font-size: var(--_typography---size--h5);
    font-stretch: var(--_typography---stretch--poster);
    font-weight: var(--_typography---font--primary-bold);
    color: var(--_theme---text);
    text-decoration: none;
  }
  .bus-bar_icon {
    width: var(--_spacing---space--5);
    height: var(--_spacing---space--5);
    flex-shrink: 0;
  }
  .bus-bar_link.is-primary {
    background-color: var(--color--bus-yellow);
    color: var(--color--bus-black);
  }
</style>
