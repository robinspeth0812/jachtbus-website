---
// Questions as native disclosure widgets: keyboard and screen readers work
// without script, and search engines see all answers. The FAQPage data is added
// by the page through faqSchema().
import type { Faq } from '../../data/nieuw';

interface Props {
  /** Section title. */
  title?: string;
  /** The questions and answers. */
  items: Faq[];
  /** Section theme. */
  theme?: 'beige' | 'green';
}
const { title = 'Veelgestelde vragen', items, theme = 'beige' } = Astro.props;
// More than seven questions: the title on top and the questions over two columns.
const split = items.length > 7;
const columns = split ? [items.slice(0, Math.ceil(items.length / 2)), items.slice(Math.ceil(items.length / 2))] : [items];
---

<section class:list={['bus-faq_wrap', 'u-section', `u-theme-bus-${theme}`]}>
  <div class="bus-faq_contain u-container">
    <div class:list={['bus-faq_layout', split && 'is-split']}>
      <h2 class="bus-faq_title u-text-style-poster-small">{title}</h2>
      {columns.map((column) => (
      <div class="bus-faq_list">
        {column.map((item) => (
          <details class="bus-faq_item" name="bus-faq">
            <summary class="bus-faq_question u-text-style-bus-title" data-trigger="hover focus">
              <span class="bus-faq_text">{item.vraag}</span>
              <svg class="bus-faq_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path class="bus-faq_icon_v" d="M12 4v16" stroke="currentColor" stroke-width="3" /><path d="M4 12h16" stroke="currentColor" stroke-width="3" /></svg>
            </summary>
            <p class="bus-faq_answer u-text-style-main">{item.antwoord}</p>
          </details>
        ))}
      </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bus-faq_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .bus-faq_layout {
    display: var(--flex-medium, grid);
    flex-direction: column;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--_spacing---space--5) var(--site--gutter);
  }
  .bus-faq_title { grid-column: 1 / span 4; }
  .bus-faq_list {
    grid-column: 6 / span 7;
    width: 100%;
  }
  .bus-faq_layout.is-split .bus-faq_title { grid-column: 1 / -1; }
  .bus-faq_layout.is-split .bus-faq_list { grid-column: span 6; }
  /* Stacked on a phone the two columns read as one list, without a gap between them. */
  .bus-faq_layout.is-split .bus-faq_list + .bus-faq_list { margin-top: calc(var(--_spacing---space--5) * -1 * (1 - var(--_responsive---large))); }
  .bus-faq_item { border-top: var(--border-width--main) solid var(--_theme---divider); }
  .bus-faq_item:last-child { border-bottom: var(--border-width--main) solid var(--_theme---divider); }
  .bus-faq_question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--_spacing---space--4);
    min-height: calc(var(--target--min) * 1.5);
    padding-block: var(--_spacing---space--3);
    cursor: pointer;
    list-style: none;
    transform: translateX(calc(var(--_spacing---space--2) * var(--_trigger---off)));
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bus-faq_question::-webkit-details-marker { display: none; }
  .bus-faq_icon {
    flex-shrink: 0;
    width: var(--size--modal-icon);
    height: var(--size--modal-icon);
  }
  .bus-faq_icon_v {
    transform-origin: center;
    transition: transform 200ms;
  }
  .bus-faq_item[open] .bus-faq_icon_v { transform: scaleY(0); }
  .bus-faq_answer {
    max-width: 62ch;
    padding-bottom: var(--_spacing---space--4);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bus-faq_item { interpolate-size: allow-keywords; }
    .bus-faq_item::details-content {
      height: 0;
      overflow: clip;
      transition: height 250ms cubic-bezier(0.16, 1, 0.3, 1), content-visibility 250ms allow-discrete;
    }
    .bus-faq_item[open]::details-content { height: auto; }
  }
</style>
