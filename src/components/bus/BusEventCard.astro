---
// One public event as a card: a tear-off calendar page with the day, then what,
// when and where. Used in the event grid and in the agenda slider.
import type { Evenement } from '../../lib/cms';
import { formatDag, tijden, wanneer } from '../../lib/agenda';

interface Props {
  /** The event, as it comes from the portal. */
  item: Evenement;
  /** Heading level of the event name, so it fits the outline of the page. */
  level?: 'h3' | 'h4';
  /** Show the "Openbaar event" label, for lists that mix events with bookings. */
  tag?: boolean;
}
const { item, level = 'h3', tag = false } = Astro.props;
const Heading = level;
const extern = (href: string) => /^https?:\/\//.test(href);
const tijd = tijden(item);
---

<article class="bus-event-card_wrap">
  <p class="bus-event-card_date" aria-hidden="true">
    <span class="bus-event-card_day u-text-style-poster-row">{formatDag(item.datum, { day: 'numeric' })}</span>
    <span class="bus-event-card_month">{formatDag(item.datum, { month: 'short' }).replace('.', '')}</span>
  </p>
  <div class="bus-event-card_body">
    {tag && (
      <p class="bus-event-card_tag u-text-style-small">
        <svg class="bus-event-card_tag_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        Openbaar event, iedereen welkom
      </p>
    )}
    <Heading class="bus-event-card_name u-text-style-bus-title">{item.titel}</Heading>
    <p class="bus-event-card_when">
      <time datetime={item.datum}>{wanneer(item)}</time>{tijd && <span class="bus-event-card_time">, {tijd}</span>}
    </p>
    <p class="bus-event-card_where u-text-style-small">{[item.locatie, item.plaats].filter(Boolean).join(', ')}</p>
    {item.tekst && <p class="bus-event-card_text">{item.tekst}</p>}
    {item.linkUrl && (
      <a class="bus-event-card_link" href={item.linkUrl} rel={extern(item.linkUrl) ? 'external' : undefined} data-trigger="hover focus">
        {item.linkTekst || 'Meer info'}
        {extern(item.linkUrl) && <span class="u-sr-only"> (andere website)</span>}
        <svg class="bus-event-card_arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.500" /></svg>
      </a>
    )}
  </div>
</article>

<style>
  .bus-event-card_wrap {
    display: flex;
    gap: var(--_spacing---space--4);
    width: 100%;
    height: 100%;
    padding: var(--_spacing---space--5);
    background-color: var(--_theme---background-2);
  }
  /* A tear-off calendar page: the day big, the month under it. */
  .bus-event-card_date {
    display: flex;
    flex: 0 0 auto;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-width: var(--size--first-tile);
    padding: var(--_spacing---space--2) var(--_spacing---space--3);
    border: var(--focus--width) solid var(--_theme---border);
    line-height: 1;
  }
  .bus-event-card_day { color: var(--_theme---text-accent); }
  .bus-event-card_month {
    margin-top: var(--_spacing---space--1);
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
  }
  .bus-event-card_body {
    display: flex;
    flex: 1 1 auto;
    flex-flow: column;
    align-items: flex-start;
    gap: var(--_spacing---space--2);
    min-width: 0;
  }
  .bus-event-card_tag {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
    color: var(--_theme---text-accent);
    font-weight: var(--_typography---font--primary-bold);
  }
  .bus-event-card_tag_icon {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
  }
  .bus-event-card_when::first-letter { text-transform: uppercase; }
  .bus-event-card_when { font-weight: var(--_typography---font--primary-bold); }
  .bus-event-card_link {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
    min-height: var(--target--min);
    margin-top: auto;
    color: var(--_theme---heading);
    text-decoration: underline;
    text-underline-offset: var(--_spacing---space--1);
  }
  .bus-event-card_arrow {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
    transform: translateX(calc(var(--_spacing---space--1) * var(--_trigger---off)));
  }
  @media (prefers-reduced-motion: no-preference) {
    .bus-event-card_arrow { transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1); }
  }
</style>
