---
// Real reviews from the portal, as cards. Renders nothing as long as there are
// none: no sample quotes, no stars, no invented numbers.
import { casePaginas, url } from '../../data/nieuw';
import { getInhoud } from '../../lib/cms';

interface Props {
  /** Section title. */
  title?: string;
  /** Only reviews linked to one of these cases, by slug. Leave out for all reviews. */
  cases?: string[];
}
const { title = 'Echte feesten, echte reacties', cases } = Astro.props;
const { reviews: allReviews } = await getInhoud();
const reviews = cases ? allReviews.filter((review) => review.caseSlug && cases.includes(review.caseSlug)) : allReviews;
// A case with its own page links there, otherwise to its story on the references page.
const caseLink = (slug: string) => (casePaginas[slug] ? url(casePaginas[slug]) : `${url('referenties')}#${slug}`);
---

{reviews.length > 0 && (
  <section class="bus-reviews_wrap u-section u-theme-bus-beige">
    <div class="bus-reviews_contain u-container">
      <h2 class="bus-reviews_title u-text-style-poster-small">{title}</h2>
      <ul class="bus-reviews_list">
        {reviews.map((review) => (
          <li class="bus-reviews_item">
            <figure class="bus-reviews_card">
              {review.fotoUrl && <img class="bus-reviews_img" src={review.fotoUrl} alt={review.fotoAlt ?? ''} loading="lazy" />}
              <div class="bus-reviews_body">
                <blockquote class="bus-reviews_block"><p class="bus-reviews_text u-text-style-main">{review.tekst}</p></blockquote>
                <figcaption class="bus-reviews_credit">
                  <span class="bus-reviews_name u-text-style-bus-title">{review.naam}</span>
                  {(review.gelegenheid || review.plaats) && (
                    <span class="bus-reviews_meta u-text-style-small">{[review.gelegenheid, review.plaats].filter(Boolean).join(' in ')}</span>
                  )}
                  {review.bronUrl
                    ? <a class="bus-reviews_source u-text-style-small" href={review.bronUrl} rel="external">Bekijk op {review.bron}</a>
                    : <span class="bus-reviews_meta u-text-style-small">Via {review.bron}</span>}
                  {review.caseSlug && (
                    <a class="bus-reviews_case" href={caseLink(review.caseSlug)} aria-label={`Lees het hele verhaal: ${review.caseTitel}`} data-trigger="hover focus">
                      Lees het hele verhaal
                      <svg class="bus-reviews_arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.500" /></svg>
                    </a>
                  )}
                </figcaption>
              </div>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .bus-reviews_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .bus-reviews_contain { gap: var(--_spacing---space--6); }
  /* As many columns as fit, so this needs no breakpoints. */
  .bus-reviews_list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size--review-card)), 1fr));
    gap: var(--site--gutter);
  }
  .bus-reviews_item { display: flex; }
  .bus-reviews_card {
    display: flex;
    flex-flow: column;
    width: 100%;
    background-color: var(--_theme---background-2);
  }
  .bus-reviews_img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .bus-reviews_body {
    display: flex;
    flex: 1 1 auto;
    flex-flow: column;
    gap: var(--_spacing---space--4);
    padding: var(--_spacing---space--5);
  }
  /* The name sits at the bottom, so cards in one row line up. */
  .bus-reviews_credit {
    display: flex;
    flex-flow: column;
    align-items: flex-start;
    gap: var(--_spacing---space--1);
    margin-top: auto;
  }
  .bus-reviews_source {
    display: inline-flex;
    align-items: center;
    min-height: var(--target--min);
    color: var(--_theme---text-link--text);
  }
  .bus-reviews_case {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
    min-height: var(--target--min);
    color: var(--_theme---heading);
    text-decoration: underline;
    text-underline-offset: var(--_spacing---space--1);
  }
  .bus-reviews_arrow {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
    transform: translateX(calc(var(--_spacing---space--1) * var(--_trigger---off)));
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>
