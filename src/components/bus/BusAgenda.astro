---
// The full agenda, per month: public events with all their details, and private
// bookings as a date only, because who books the bus is nobody else's business.
// The two differ in words and icon, not just in colour. The note that an empty
// day is no free day is always there, also when the agenda is empty.
// With the script running you can switch to a month calendar with a block per
// day; without it you get the list, which holds everything.
import { getInhoud } from '../../lib/cms';
import { agendaPerMaand, formatDag, kalenderMaanden, langeDatum, wanneer } from '../../lib/agenda';
import BusEventCard from './BusEventCard.astro';
import BusAgendaNote from './BusAgendaNote.astro';

interface Props {
  /** Section title. */
  title?: string;
  /** Short line under the title. */
  text?: string;
  /** Text when there is nothing in the agenda at all. */
  emptyText?: string;
  /** Section theme. */
  theme?: 'beige' | 'green';
}
const {
  title = 'De volledige agenda',
  text = 'Openbare events met alles erbij. Bij een boeking zie je alleen de datum: dat feest is van iemand anders.',
  emptyText = 'Er staat nu niets in de agenda.',
  theme = 'beige',
} = Astro.props;
const { evenementen, bezet } = await getInhoud();
const maanden = agendaPerMaand(evenementen, bezet);
const kalender = kalenderMaanden(evenementen, bezet);
const weekdagen = ['maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag', 'zondag'];
const hoofdletter = (tekst: string) => tekst.replace(/^./, (c) => c.toUpperCase());
const kaartId = (sleutel: string, index: number) => `agenda-${sleutel}-${index}`;
---

<section class:list={['bus-agenda_wrap', 'u-section', `u-theme-bus-${theme}`]}>
  <div class="bus-agenda_contain u-container">
    <div class="bus-agenda_head">
      <h2 class="bus-agenda_title u-text-style-poster-small">{title}</h2>
      {text && <p class="bus-agenda_intro u-text-style-large">{text}</p>}
    </div>
    <BusAgendaNote />
    <div class="bus-agenda_views" role="group" aria-label="Weergave van de agenda" hidden>
      <button class="bus-agenda_view" type="button" aria-pressed="true" data-view="lijst" data-trigger="hover focus">
        <svg class="bus-agenda_view_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2.500" /></svg>
        Lijst
      </button>
      <button class="bus-agenda_view" type="button" aria-pressed="false" data-view="kalender" data-trigger="hover focus">
        <svg class="bus-agenda_view_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.500" y="5" width="17" height="15.500" stroke="currentColor" stroke-width="2" /><path d="M3.500 10h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" /></svg>
        Kalender
      </button>
    </div>
    <div class="bus-agenda_calendar" hidden>
      {kalender.map((maand, index) => (
        <div class="bus-agenda_cal_wrap" hidden={index > 0}>
          <div class="bus-agenda_cal_bar">
            <button
              class="bus-agenda_cal_button is-prev"
              type="button"
              aria-label={index > 0 ? `Vorige maand: ${kalender[index - 1].naam}` : 'Vorige maand'}
              disabled={index === 0}
              data-trigger="hover focus"
            >
              <svg class="bus-agenda_cal_arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13.500 8h-10M7.500 3.500 3 8l4.500 4.500" stroke="currentColor" stroke-width="2.500" /></svg>
            </button>
            <h3 class="bus-agenda_cal_title u-text-style-bus-title">{hoofdletter(maand.naam)}</h3>
            <button
              class="bus-agenda_cal_button is-next"
              type="button"
              aria-label={index < kalender.length - 1 ? `Volgende maand: ${kalender[index + 1].naam}` : 'Volgende maand'}
              disabled={index === kalender.length - 1}
              data-trigger="hover focus"
            >
              <svg class="bus-agenda_cal_arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.500 8h10M8.500 3.500 13 8l-4.500 4.500" stroke="currentColor" stroke-width="2.500" /></svg>
            </button>
          </div>
          <table class="bus-agenda_cal_grid">
            <caption class="u-sr-only">Agenda van {maand.naam}</caption>
            <thead>
              <tr class="bus-agenda_cal_row">
                {weekdagen.map((dag) => (
                  <th class="bus-agenda_cal_weekday u-text-style-small" scope="col" abbr={dag}>{dag.slice(0, 2)}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {maand.weken.map((week) => (
                <tr class="bus-agenda_cal_row">
                  {week.map((dag) => {
                    if (!dag) return <td class="bus-agenda_cal_day is-blank"></td>;
                    const eerste = maand.events.findIndex((item) => dag.events.includes(item));
                    const inhoud = (
                      <>
                        <span class="bus-agenda_cal_num">
                          <span aria-hidden="true">{formatDag(dag.datum, { day: 'numeric' })}</span>
                          <span class="u-sr-only">{langeDatum(dag.datum)}{dag.vandaag && ', vandaag'}</span>
                        </span>
                        {dag.events.map((item) => (
                          <span class="bus-agenda_cal_mark is-event u-text-style-small">
                            <svg class="bus-agenda_cal_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5" stroke="currentColor" stroke-width="2.500" stroke-linejoin="round" /></svg>
                            <span class="bus-agenda_cal_label">
                              <span class="u-sr-only">Openbaar event: </span>
                              {item.titel}
                            </span>
                          </span>
                        ))}
                        {dag.bezet && (
                          <span class="bus-agenda_cal_mark is-booked u-text-style-small">
                            <svg class="bus-agenda_cal_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                              <rect x="5" y="10.500" width="14" height="10" stroke="currentColor" stroke-width="2.500" />
                              <path d="M8.500 10.500V7.500a3.500 3.500 0 0 1 7 0v3" stroke="currentColor" stroke-width="2.500" />
                            </svg>
                            <span class="bus-agenda_cal_label">Geboekt<span class="u-sr-only">, privéfeest</span></span>
                          </span>
                        )}
                      </>
                    );
                    return (
                      <td class:list={['bus-agenda_cal_day', dag.events.length > 0 && 'is-event', dag.bezet && 'is-booked', dag.vandaag && 'is-today', dag.voorbij && 'is-past']}>
                        {eerste >= 0 ? (
                          <a class="bus-agenda_cal_cell" href={`#${kaartId(maand.sleutel, eerste)}`} data-trigger="hover focus">{inhoud}</a>
                        ) : (
                          <span class="bus-agenda_cal_cell">{inhoud}</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
          {maand.events.length > 0 ? (
            <ul class="bus-agenda_list" aria-label={`Events in ${maand.naam}`}>
              {maand.events.map((item, eventIndex) => (
                <li class="bus-agenda_item" id={kaartId(maand.sleutel, eventIndex)}>
                  <BusEventCard item={item} level="h4" tag />
                </li>
              ))}
            </ul>
          ) : (
            <p class="bus-agenda_cal_empty">In {maand.naam} staan we niet op een openbaar event.</p>
          )}
        </div>
      ))}
      <ul class="bus-agenda_legend" aria-label="Uitleg bij de kalender">
        <li class="bus-agenda_legend_item">
          <span class="bus-agenda_cal_mark is-event"><svg class="bus-agenda_cal_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5" stroke="currentColor" stroke-width="2.500" stroke-linejoin="round" /></svg></span>
          Openbaar event: kom langs
        </li>
        <li class="bus-agenda_legend_item">
          <span class="bus-agenda_cal_mark is-booked">
            <svg class="bus-agenda_cal_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10.500" width="14" height="10" stroke="currentColor" stroke-width="2.500" /><path d="M8.500 10.500V7.500a3.500 3.500 0 0 1 7 0v3" stroke="currentColor" stroke-width="2.500" /></svg>
          </span>
          Geboekt: een privéfeest
        </li>
      </ul>
    </div>
    <div class="bus-agenda_listview">
    {maanden.length === 0 ? (
      <p class="bus-agenda_empty u-text-style-large">{emptyText}</p>
    ) : (
      <div class="bus-agenda_months">
        {maanden.map((maand) => (
          <div class="bus-agenda_month">
            <h3 class="bus-agenda_month-title u-text-style-bus-title">{maand.naam.replace(/^./, (c) => c.toUpperCase())}</h3>
            <ul class="bus-agenda_list">
              {maand.items.map((regel) =>
                regel.soort === 'event' ? (
                  <li class="bus-agenda_item">
                    <BusEventCard item={regel.item} level="h4" tag />
                  </li>
                ) : (
                  <li class="bus-agenda_item">
                    <div class="bus-agenda_booking_wrap">
                      <p class="bus-agenda_booking_date" aria-hidden="true">
                        <span class="bus-agenda_booking_day u-text-style-poster-row">{formatDag(regel.item.datum, { day: 'numeric' })}</span>
                        <span class="bus-agenda_booking_month">{formatDag(regel.item.datum, { month: 'short' }).replace('.', '')}</span>
                      </p>
                      <div class="bus-agenda_booking_body">
                        <p class="bus-agenda_booking_tag u-text-style-small">
                          <svg class="bus-agenda_booking_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="5" y="10.500" width="14" height="10" stroke="currentColor" stroke-width="2" />
                            <path d="M8.500 10.500V7.500a3.500 3.500 0 0 1 7 0v3" stroke="currentColor" stroke-width="2" />
                          </svg>
                          Geboekt, privéfeest
                        </p>
                        <p class="bus-agenda_booking_when">
                          <time datetime={regel.item.datum}>{wanneer(regel.item)}</time>
                        </p>
                        <p class="bus-agenda_booking_text u-text-style-small">De bus is bezet. Niet openbaar, dus geen naam of plek.</p>
                      </div>
                    </div>
                  </li>
                ),
              )}
            </ul>
          </div>
        ))}
      </div>
    )}
    </div>
  </div>
</section>

<style>
  .bus-agenda_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .bus-agenda_contain {
    display: flex;
    flex-flow: column;
    align-items: flex-start;
    gap: var(--_spacing---space--6);
  }
  .bus-agenda_head {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--3);
    max-width: 60ch;
  }
  .bus-agenda_empty { max-width: 50ch; }
  .bus-agenda_months {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--7);
    width: 100%;
  }
  .bus-agenda_month {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--4);
  }
  .bus-agenda_month-title {
    padding-bottom: var(--_spacing---space--2);
    border-bottom: var(--focus--width) solid var(--_theme---border);
  }
  .bus-agenda_list {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--3);
    max-width: var(--max-width--main);
  }
  .bus-agenda_item { display: flex; }
  /* A booking: the same calendar page, but hollow and quiet, so an event stands out. */
  .bus-agenda_booking_wrap {
    display: flex;
    gap: var(--_spacing---space--4);
    width: 100%;
    padding: var(--_spacing---space--4) var(--_spacing---space--5);
    border: var(--focus--width) dashed var(--_theme---divider);
  }
  .bus-agenda_booking_date {
    display: flex;
    flex: 0 0 auto;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-width: var(--size--first-tile);
    padding: var(--_spacing---space--2) var(--_spacing---space--3);
    border: var(--focus--width) dashed var(--_theme---border);
    line-height: 1;
  }
  .bus-agenda_booking_month {
    margin-top: var(--_spacing---space--1);
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
  }
  .bus-agenda_booking_body {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--1);
    min-width: 0;
  }
  .bus-agenda_booking_tag {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
    font-weight: var(--_typography---font--primary-bold);
  }
  .bus-agenda_booking_icon {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
  }
  .bus-agenda_booking_when { font-weight: var(--_typography---font--primary-bold); }
  .bus-agenda_booking_when::first-letter { text-transform: uppercase; }

  /* Switch between list and calendar. Pressed shows a filled chip, and the
     icon tells the two apart, so color is not the only signal. */
  .bus-agenda_views {
    display: flex;
    flex-wrap: wrap;
    gap: var(--_spacing---space--2);
  }
  .bus-agenda_views[hidden],
  .bus-agenda_calendar[hidden],
  .bus-agenda_listview[hidden],
  .bus-agenda_cal_wrap[hidden] { display: none; }
  .bus-agenda_view {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--4);
    background-color: color-mix(in hsl, var(--color--bus-green) calc(100% * var(--_state---false)), var(--_theme---background-2) calc(100% * var(--_state---true)));
    color: color-mix(in hsl, var(--color--white) calc(100% * var(--_state---false)), var(--_theme---text) calc(100% * var(--_state---true)));
    border: var(--border-width--main) solid color-mix(in hsl, var(--color--bus-green) calc(100% * var(--_trigger---off) + 100% * var(--_state---false)), transparent);
    font-family: var(--_typography---font--heading);
    font-stretch: var(--_typography---stretch--poster);
    font-weight: var(--_typography---font--primary-bold);
    cursor: pointer;
  }
  .bus-agenda_view_icon {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
  }

  /* The month calendar: one month at a time, a block per day. */
  .bus-agenda_calendar {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--5);
    width: 100%;
    max-width: var(--max-width--main);
  }
  .bus-agenda_cal_wrap {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--4);
    container-type: inline-size;
  }
  .bus-agenda_cal_bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--_spacing---space--3);
  }
  .bus-agenda_cal_title { text-align: center; }
  .bus-agenda_cal_button {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: var(--size--slider-button);
    height: var(--size--slider-button);
    min-width: var(--target--min);
    min-height: var(--target--min);
    padding: 0;
    background-color: color-mix(in hsl, var(--_theme---text) calc(100% * var(--_trigger---on)), transparent calc(100% * var(--_trigger---off)));
    color: color-mix(in hsl, var(--_theme---background) calc(100% * var(--_trigger---on)), var(--_theme---text) calc(100% * var(--_trigger---off)));
    border: var(--focus--width) solid var(--_theme---border);
    border-radius: var(--radius--round);
    cursor: pointer;
  }
  .bus-agenda_cal_button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .bus-agenda_cal_arrow {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
  }
  .bus-agenda_cal_grid {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: var(--_spacing---space--1);
  }
  .bus-agenda_cal_weekday {
    padding-bottom: var(--_spacing---space--1);
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
    text-align: center;
  }
  .bus-agenda_cal_day {
    height: var(--size--cal-day);
    padding: 0;
    vertical-align: top;
    background-color: var(--_theme---background-2);
    border: var(--border-width--main) solid transparent;
  }
  .bus-agenda_cal_day.is-blank { background-color: transparent; }
  .bus-agenda_cal_day.is-past { opacity: 0.45; }
  /* A booking: hollow and dashed, like the booking in the list. */
  .bus-agenda_cal_day.is-booked {
    background-color: transparent;
    border: var(--focus--width) dashed var(--_theme---border);
  }
  /* An event: the gold edge on top makes it the loudest block in the month. */
  .bus-agenda_cal_day.is-event {
    background-color: var(--_theme---background-2);
    border: var(--border-width--main) solid var(--_theme---border);
    border-top: var(--size--stripe-thin) solid var(--_theme---text-accent);
  }
  .bus-agenda_cal_cell {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--1);
    width: 100%;
    height: 100%;
    min-height: var(--target--min);
    padding: var(--_spacing---space--2);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }
  .bus-agenda_cal_day.is-event .bus-agenda_cal_cell {
    background-color: color-mix(in hsl, var(--_theme---text) calc(8% * var(--_trigger---on)), transparent);
  }
  .bus-agenda_cal_num {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-width: var(--size--cal-today);
    height: var(--size--cal-today);
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
    line-height: 1;
  }
  .bus-agenda_cal_day.is-today .bus-agenda_cal_num {
    background-color: var(--color--bus-green);
    color: var(--color--white);
    border-radius: var(--radius--round);
  }
  .bus-agenda_cal_mark {
    display: flex;
    align-items: flex-start;
    gap: var(--_spacing---space--1);
    min-width: 0;
    line-height: 1.2;
  }
  .bus-agenda_cal_mark.is-event {
    color: var(--_theme---text-accent);
    font-weight: var(--_typography---font--primary-bold);
  }
  .bus-agenda_cal_icon {
    flex: 0 0 auto;
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
  }
  .bus-agenda_cal_label {
    min-width: 0;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bus-agenda_cal_empty { max-width: 50ch; }
  .bus-agenda_legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--_spacing---space--2) var(--_spacing---space--5);
  }
  .bus-agenda_legend_item {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
  }
  /* On a phone the blocks get too small for names: only the icon stays, the
     name is still read out, and the event cards under the grid tell the rest. */
  @container (width < 30em) {
    .bus-agenda_cal_day { height: var(--size--cal-day-small); }
    .bus-agenda_cal_cell {
      align-items: center;
      padding: var(--_spacing---space--1);
    }
    .bus-agenda_cal_num { align-self: center; }
    .bus-agenda_cal_label {
      position: absolute;
      width: var(--border-width--main);
      height: var(--border-width--main);
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .bus-agenda_view,
    .bus-agenda_cal_button,
    .bus-agenda_cal_cell { transition: background-color 150ms, color 150ms, border-color 150ms; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.bus-agenda_wrap').forEach((root) => {
    const views = root.querySelector<HTMLElement>('.bus-agenda_views');
    const calendar = root.querySelector<HTMLElement>('.bus-agenda_calendar');
    const list = root.querySelector<HTMLElement>('.bus-agenda_listview');
    if (!views || !calendar || !list) return;
    const buttons = [...views.querySelectorAll<HTMLButtonElement>('.bus-agenda_view')];
    const months = [...calendar.querySelectorAll<HTMLElement>('.bus-agenda_cal_wrap')];
    const key = 'jachtbus-agenda-weergave';

    const setView = (view: string, remember = true) => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.view === view)));
      calendar.hidden = view !== 'kalender';
      list.hidden = view === 'kalender';
      if (!remember) return;
      try {
        localStorage.setItem(key, view);
      } catch {
        // No storage (private window): the choice just isn't remembered.
      }
    };
    buttons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.view ?? 'lijst')));

    // Page through the months; focus moves along so the keyboard keeps its place.
    months.forEach((month, index) => {
      const go = (to: number, direction: 'is-prev' | 'is-next') => {
        months.forEach((other, i) => (other.hidden = i !== to));
        const target = months[to].querySelector<HTMLButtonElement>(`.bus-agenda_cal_button.${direction}`);
        const fallback = months[to].querySelector<HTMLButtonElement>('.bus-agenda_cal_button:not(:disabled)');
        (target && !target.disabled ? target : fallback)?.focus();
      };
      month.querySelector('.bus-agenda_cal_button.is-prev')?.addEventListener('click', () => index > 0 && go(index - 1, 'is-prev'));
      month.querySelector('.bus-agenda_cal_button.is-next')?.addEventListener('click', () => index < months.length - 1 && go(index + 1, 'is-next'));
    });

    views.hidden = false;
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(key);
    } catch {
      stored = null;
    }
    if (stored === 'kalender' && months.length > 0) setView('kalender', false);
  });
</script>
