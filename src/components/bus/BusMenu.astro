---
// The ways we serve, set like a menu board next to a round photo of the food.
// A way with its own page links there; the others are plain names.
import BusPhoto from './BusPhoto.astro';
import { arrangementPaginas, photos, url } from '../../data/nieuw';
import { getInhoud } from '../../lib/cms';

interface Props {
  /** Section title. */
  title?: string;
  /** Line under the title. */
  text?: string;
}
const { title = 'Wat er uit de bus komt', text = 'Er is geen vaste kaart. We kijken samen naar het seizoen, je gasten en de vorm van je feest. Dit zijn de vormen waar we meestal mee beginnen.' } = Astro.props;
const { arrangementen } = await getInhoud();
---

<section class="bus-menu-board_wrap u-section u-theme-bus-beige">
  <div class="bus-menu-board_contain u-container">
    <div class="bus-menu-board_layout">
      <div class="bus-menu-board_visual">
        <BusPhoto photo={photos.smoker} shape="circle" focus="50% 60%" />
        <div class="bus-menu-board_second"><BusPhoto photo={photos.plank} shape="corner" /></div>
      </div>
      <div class="bus-menu-board_content">
        <h2 class="bus-menu-board_title u-text-style-poster-small">{title}</h2>
        <p class="bus-menu-board_text u-text-style-large">{text}</p>
        <ul class="bus-menu-board_list">
          {arrangementen.map((item) => (
            <li class="bus-menu-board_item">
              <h3 class="bus-menu-board_name u-text-style-poster-label">
                {arrangementPaginas[item.title] ? (
                  <a class="bus-menu-board_link" href={url(`catering/${arrangementPaginas[item.title]}`)} data-trigger="hover focus">
                    {item.title}<svg class="bus-menu-board_arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.500 8h10M8.500 3.500 13 8l-4.500 4.500" stroke="currentColor" stroke-width="2.500" /></svg>
                  </a>
                ) : item.title}
              </h3>
              <p class="bus-menu-board_desc u-text-style-main">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .bus-menu-board_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .bus-menu-board_layout {
    display: var(--flex-medium, grid);
    flex-direction: column;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--_spacing---space--6) var(--site--gutter);
    align-items: start;
  }
  .bus-menu-board_visual {
    grid-column: 1 / span 5;
    position: relative;
    width: 100%;
    padding-bottom: 30%;
  }
  .bus-menu-board_second {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 55%;
    border: var(--size--stripe-thin) solid var(--_theme---background);
    border-top-right-radius: var(--radius--shape);
  }
  .bus-menu-board_content {
    grid-column: 7 / span 6;
    width: 100%;
  }
  .bus-menu-board_title { margin-bottom: var(--_spacing---space--4); }
  .bus-menu-board_text {
    max-width: 50ch;
    margin-bottom: var(--_spacing---space--5);
  }
  .bus-menu-board_item {
    padding-block: var(--_spacing---space--3);
    border-top: var(--border-width--main) solid var(--_theme---divider);
  }
  .bus-menu-board_name { margin-bottom: var(--_spacing---space--1); }
  .bus-menu-board_link {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
    min-height: var(--target--min);
    color: color-mix(in hsl, var(--_theme---heading) calc(100% * var(--_trigger---on)), var(--_theme---text-accent) calc(100% * var(--_trigger---off)));
    text-decoration: none;
    transition: color 150ms;
  }
  /* No underline on the name: a small arrow says it leads somewhere, and nudges on hover. */
  .bus-menu-board_arrow {
    flex: 0 0 auto;
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
    transform: translateX(calc(var(--_spacing---space--1) * var(--_trigger---off)));
  }
  @media (prefers-reduced-motion: no-preference) {
    .bus-menu-board_arrow { transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1); }
  }
  .bus-menu-board_desc { max-width: 48ch; }
</style>
