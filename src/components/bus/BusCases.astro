---
// Jobs from the portal as cards. With filters they can be narrowed down by occasion
// and by option; the filters only offer what really exists, and without the script
// all jobs simply stay in view. Renders nothing when there are no jobs.
import { aanvraagUrl, casePaginas, url } from '../../data/nieuw';
import type { Referentie } from '../../lib/cms';

interface Props {
  /** Section title. */
  title?: string;
  /** The jobs to show. */
  items: Referentie[];
  /** Show the filters for occasion and option. */
  filters?: boolean;
  /** Show a link to the page with all jobs. */
  more?: boolean;
}
const { title = 'Een paar feesten', items, filters = false, more = false } = Astro.props;
const dateLabel = (date: string) => new Intl.DateTimeFormat('nl-NL', { month: 'long', year: 'numeric' }).format(new Date(`${date}T12:00:00Z`));
const unique = (list: string[]) => [...new Set(list)].sort((a, b) => a.localeCompare(b, 'nl'));
const groups = [
  { key: 'gelegenheid', label: 'Gelegenheden', values: unique(items.map((item) => item.gelegenheid)) },
  { key: 'mogelijkheid', label: 'Mogelijkheden', values: unique(items.flatMap((item) => item.mogelijkheden ?? [])) },
].filter((group) => group.values.length > 0);
// A long story opens under the card, so the cards stay comparable.
const splitStory = (text: string) => {
  if (text.length <= 240) return [text, ''];
  const cut = text.lastIndexOf(' ', 200);
  return [text.slice(0, cut), text.slice(cut + 1)];
};
---

{items.length > 0 && (
  <section class="cases_wrap u-section u-theme-bus-beige">
    <div class="cases_contain u-container">
      <h2 class="cases_title u-text-style-poster-small">{title}</h2>
      {filters && groups.length > 0 && <div class="cases_filters" hidden>
        <div class="cases_selects">
          {groups.map((filter) => (
            <label class="cases_select_wrap">
              <span class="cases_select_label u-text-style-small">{filter.label}</span>
              <span class="cases_select_box">
                <select class="cases_select" data-filter={filter.key} data-trigger="hover focus">
                  <option value="">Alle {filter.label.toLowerCase()}</option>
                  {filter.values.map((value) => <option value={value}>{value}</option>)}
                </select>
                <svg class="cases_select_icon is-check" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.500 8.500 6.500 12.500 13.500 4" stroke="currentColor" stroke-width="2.500" /></svg>
                <svg class="cases_select_icon is-caret" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.500 6 8 10.500 12.500 6" stroke="currentColor" stroke-width="2.500" /></svg>
              </span>
            </label>
          ))}
          <button class="cases_reset u-text-style-main" type="button" hidden>Wis filters</button>
        </div>
        <p class="cases_count u-text-style-main" role="status"></p>
      </div>}
      <ul class="cases_list">
        {items.map((item) => {
          const [start, rest] = splitStory(item.verhaal);
          return (
            <li class="cases_item" id={item.slug} data-gelegenheid={item.gelegenheid} data-mogelijkheid={(item.mogelijkheden ?? []).join('|')}>
              <article class="cases_card">
                {item.fotoUrl && <img class="cases_img" src={item.fotoUrl} alt={item.fotoAlt ?? ''} loading="lazy" />}
                <div class="cases_body">
                  <h3 class="cases_name u-text-style-poster-label">{item.titel}</h3>
                  <p class="cases_meta u-text-style-small">
                    {item.gelegenheid} in {item.plaats}{item.gasten && `, ${item.gasten} gasten`}{item.datum && `, ${dateLabel(item.datum)}`}
                  </p>
                  <p class="cases_text u-text-style-main">{start}{rest && '...'}</p>
                  {rest && (
                    <details class="cases_more">
                      <summary class="cases_more_title u-text-style-main">Lees verder</summary>
                      <p class="cases_text u-text-style-main">{rest}</p>
                    </details>
                  )}
                  {item.mogelijkheden && item.mogelijkheden.length > 0 && (
                    <ul class="cases_tags">
                      {item.mogelijkheden.map((tag) => <li class="cases_tag u-text-style-small">{tag}</li>)}
                    </ul>
                  )}
                  {casePaginas[item.slug] && <a class="cases_link u-text-style-main" href={url(casePaginas[item.slug])}>Lees het hele verhaal</a>}
                </div>
              </article>
            </li>
          );
        })}
      </ul>
      {filters && (
        <p class="cases_empty u-text-style-large" hidden>
          Hier staat nog geen feest van tussen. Wil jij de eerste zijn? <a class="cases_empty_link" href={aanvraagUrl()}>Doe je aanvraag</a>
        </p>
      )}
      {more && <a class="cases_all u-text-style-main" href={url('referenties')}>Bekijk alle feesten</a>}
    </div>
  </section>
)}

<style>
  .cases_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .cases_contain { gap: var(--_spacing---space--5); }
  .cases_filters {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--3);
  }
  .cases_filters[hidden],
  .cases_reset[hidden] { display: none; }
  /* Dropdowns side by side; they wrap under each other only when there is no room. */
  .cases_selects {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--_spacing---space--3);
  }
  .cases_select_wrap {
    display: flex;
    flex: 0 1 var(--size--map-card);
    flex-flow: column;
    gap: var(--_spacing---space--1);
    min-width: 0;
  }
  .cases_select_label { font-weight: var(--_typography---font--primary-bold); }
  .cases_select_box {
    position: relative;
    display: flex;
    align-items: center;
  }
  /* A chosen filter turns green and shows a check, so color is not the only signal. */
  .cases_select {
    width: 100%;
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--3) var(--_spacing---space--6);
    background-color: var(--_theme---background-2);
    color: var(--_theme---text);
    border: var(--border-width--main) solid color-mix(in hsl, var(--color--bus-green) calc(100% * var(--_trigger---off)), var(--_theme---border));
    border-radius: 0;
    font-family: var(--_typography---font--heading);
    font-stretch: var(--_typography---stretch--poster);
    font-weight: var(--_typography---font--primary-bold);
    appearance: none;
    cursor: pointer;
  }
  .cases_select_wrap.is-active .cases_select {
    padding-left: var(--_spacing---space--6);
    background-color: var(--color--bus-green);
    color: var(--color--white);
    border-color: var(--color--bus-green);
  }
  .cases_select_icon {
    position: absolute;
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
    pointer-events: none;
  }
  .cases_select_icon.is-caret { right: var(--_spacing---space--3); }
  .cases_select_icon.is-check {
    left: var(--_spacing---space--3);
    display: none;
  }
  .cases_select_wrap.is-active .cases_select_icon { color: var(--color--white); }
  .cases_select_wrap.is-active .cases_select_icon.is-check { display: block; }
  .cases_reset {
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--1);
    background: none;
    color: var(--_theme---text-link--text);
    border: none;
    text-decoration: underline;
    cursor: pointer;
  }
  .cases_list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--size--review-card)), 1fr));
    gap: var(--site--gutter);
  }
  .cases_item { display: flex; }
  .cases_card {
    display: flex;
    flex-flow: column;
    width: 100%;
    background-color: var(--_theme---background-2);
  }
  .cases_img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .cases_body {
    display: flex;
    flex: 1 1 auto;
    flex-flow: column;
    gap: var(--_spacing---space--2);
    padding: var(--_spacing---space--4);
  }
  .cases_more_title {
    display: list-item;
    min-height: var(--target--min);
    padding-block: var(--_spacing---space--2);
    text-decoration: underline;
    cursor: pointer;
  }
  .cases_tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--_spacing---space--2);
    margin-top: auto;
    padding-top: var(--_spacing---space--2);
  }
  .cases_tag {
    padding: var(--_spacing---space--1) var(--_spacing---space--2);
    background-color: var(--_theme---background);
  }
  .cases_link,
  .cases_empty_link { color: var(--_theme---text-link--text); }
  .cases_all {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--target--min);
    color: var(--_theme---text-link--text);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.cases_wrap').forEach((root) => {
    const filters = root.querySelector<HTMLElement>('.cases_filters');
    const count = root.querySelector<HTMLElement>('.cases_count');
    const empty = root.querySelector<HTMLElement>('.cases_empty');
    const reset = root.querySelector<HTMLButtonElement>('.cases_reset');
    if (!filters || !count || !empty || !reset) return;
    const selects = [...root.querySelectorAll<HTMLSelectElement>('.cases_select')];
    const items = [...root.querySelectorAll<HTMLElement>('.cases_item')];
    const chosen: Record<string, string> = { gelegenheid: '', mogelijkheid: '' };

    const apply = () => {
      let shown = 0;
      items.forEach((item) => {
        const fits = (!chosen.gelegenheid || item.dataset.gelegenheid === chosen.gelegenheid)
          && (!chosen.mogelijkheid || (item.dataset.mogelijkheid ?? '').split('|').includes(chosen.mogelijkheid));
        item.hidden = !fits;
        if (fits) shown += 1;
      });
      count.textContent = shown === 1 ? '1 feest' : `${shown} feesten`;
      empty.hidden = shown > 0;
    };

    selects.forEach((select) => select.addEventListener('change', () => {
      chosen[select.dataset.filter ?? ''] = select.value;
      select.closest('.cases_select_wrap')?.classList.toggle('is-active', select.value !== '');
      reset.hidden = selects.every((other) => other.value === '');
      apply();
    }));
    reset.addEventListener('click', () => {
      selects.forEach((select) => {
        select.value = '';
        chosen[select.dataset.filter ?? ''] = '';
        select.closest('.cases_select_wrap')?.classList.remove('is-active');
      });
      reset.hidden = true;
      apply();
      selects[0]?.focus();
    });    filters.hidden = false;
    apply();
  });
</script>
