---
// The working area as a live map: the three provinces lightly drawn, with a pin
// for every job from the portal. A pin opens a card about that job, which links to
// the page of the job once it has one. New references land on it with the next build.
// Next to it the towns as tags, which link to their local page once that exists.
// The live map comes from another party, so it only loads after a yes in the
// consent banner, and then when it comes near the screen. Until then the provinces
// and pins stand here as a drawing made at build time, without any outside request.
import { casePaginas, plaatsKaart, plaatsPaginas, regions, url } from '../../data/nieuw';
import type { Region } from '../../data/nieuw';
import { getInhoud, type Referentie } from '../../lib/cms';
import { casesIn, provincieVan } from '../../lib/regio';
import provincies from '../../data/provincies-noord.json';

interface Props {
  /** Section title. */
  title?: string;
  /** Text under the title. */
  text?: string;
  /** Show one province only: its towns, its outline and its jobs. */
  region?: Region;
  /** Longer text under the title, instead of the text above. */
  paragraphs?: string[];
}
const {
  title = 'Op locatie door heel Noord-Nederland',
  text = 'De Jachtbus komt door heel Drenthe, Groningen en Friesland. Wij staan op locatie, waar jij dat wilt! Evenement ergens anders? Geen probleem, we denken graag mee.',
  region,
  paragraphs = [],
} = Astro.props;

const inhoud = await getInhoud();
const referenties = region ? casesIn(region.naam, inhoud.referenties) : inhoud.referenties;
const shownRegions = region ? [region] : regions;
const features = region ? [provincieVan(region.naam)] : provincies.features;

interface Pin {
  lat: number;
  lng: number;
  naam: string;
  index?: number;
}
const inPlaats = new Map<string, number>();
const casePins: Pin[] = [];
referenties.forEach((item: Referentie, index) => {
  const lat = item.lat ?? plaatsKaart[item.plaats]?.[0];
  const lng = item.lng ?? plaatsKaart[item.plaats]?.[1];
  if (lat === undefined || lng === undefined) return;
  // Jobs in the same town sit next to each other instead of on top.
  const eerder = inPlaats.get(item.plaats) ?? 0;
  inPlaats.set(item.plaats, eerder + 1);
  casePins.push({ lat: lat + eerder * 0.012, lng: lng + eerder * 0.02, naam: item.titel, index });
});
// Until the first job is in the portal, the towns keep the map from being empty.
const dots: Pin[] = casePins.length > 0 ? [] : shownRegions.flatMap((shown) => shown.plaatsen.flatMap((naam) => {
  const punt = plaatsKaart[naam];
  return punt ? [{ lat: punt[0], lng: punt[1], naam }] : [];
}));
// The drawing: longitude narrowed for this latitude, so the shape looks right.
const ringen = features.flatMap((feature) => {
  const { type, coordinates } = feature.geometry;
  return (type === 'Polygon' ? [coordinates] : coordinates).flat() as unknown as number[][][];
}).flat() as unknown as number[][];
const grens = {
  west: Math.min(...ringen.map(([lng]) => lng)),
  oost: Math.max(...ringen.map(([lng]) => lng)),
  zuid: Math.min(...ringen.map(([, lat]) => lat)),
  noord: Math.max(...ringen.map(([, lat]) => lat)),
};
const breedteFactor = Math.cos((53 * Math.PI) / 180);
const schaal = 1000 / ((grens.oost - grens.west) * breedteFactor);
const tekenpunt = (lng: number, lat: number) => [(lng - grens.west) * breedteFactor * schaal, (grens.noord - lat) * schaal];
const tekenHoogte = Math.ceil((grens.noord - grens.zuid) * schaal);
const tekenPaden = features.map((feature) => {
  const { type, coordinates } = feature.geometry;
  const vlakken = (type === 'Polygon' ? [coordinates] : coordinates) as unknown as number[][][][];
  return vlakken.flat().map((ring) => `M${ring.map(([lng, lat]) => tekenpunt(lng, lat).map((n) => n.toFixed(1)).join(' ')).join('L')}Z`).join('');
});
const kort = (tekst: string) => (tekst.length > 120 ? `${tekst.slice(0, 120).trimEnd()}...` : tekst);
---

<section
  class="bus-map_wrap u-section u-theme-bus-beige"
  data-provincie={region ? provincieVan(region.naam).properties.naam : undefined}
  data-bounds={region ? JSON.stringify([[grens.west, grens.zuid], [grens.oost, grens.noord]]) : undefined}
>
  <div class="bus-map_contain u-container">
    <div class="bus-map_layout">
      <div class="bus-map_side">
        <div class="bus-map_intro">
          <h2 class="bus-map_title u-text-style-poster-small">{title}</h2>
          {paragraphs.length > 0
            ? paragraphs.map((paragraph) => <p class="bus-map_text u-text-style-large">{paragraph}</p>)
            : <p class="bus-map_text u-text-style-large">{text}</p>}
        </div>
        <ul class="bus-map_regions">
          {shownRegions.map((shown) => (
            <li class="bus-map_region">
              {!region && (
                <a class="bus-map_link u-text-style-bus-title" href={url(shown.slug)} data-trigger="hover focus">
                  Foodtruck in {shown.naam}
                  <svg class="bus-map_link_icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.500 8h10M8.500 3.500 13 8l-4.500 4.500" stroke="currentColor" stroke-width="2.500" /></svg>
                </a>
              )}
              <ul class="bus-map_tags">
                {shown.plaatsen.map((plaats) => (
                  <li class="bus-map_tag_item">
                    {plaatsPaginas[plaats]
                      ? <a class="bus-map_tag is-link u-text-style-small" href={url(plaatsPaginas[plaats])} data-trigger="hover focus">{plaats}</a>
                      : <span class="bus-map_tag u-text-style-small">{plaats}</span>}
                  </li>
                ))}
                {!region && (
                  <li class="bus-map_more_item">
                    <button class="bus-map_more u-text-style-small" type="button" aria-expanded="false">Meer</button>
                  </li>
                )}
              </ul>
              <slot />
            </li>
          ))}
        </ul>
      </div>
      <div class="bus-map_off">
        <svg class="bus-map_off_drawing" viewBox={`-20 -20 1040 ${tekenHoogte + 40}`} aria-hidden="true">
          {tekenPaden.map((d) => <path class="bus-map_off_province" d={d} />)}
          {[...casePins, ...dots].map((pin) => {
            const [cx, cy] = tekenpunt(pin.lng, pin.lat);
            return <circle class="bus-map_off_pin" cx={cx} cy={cy} r="14" />;
          })}
        </svg>
        <div class="bus-map_off_body">
          <p class="bus-map_off_text u-text-style-small">De kaart staat uit. Die komt van OpenFreeMap, die dan je IP-adres ziet.</p>
          <div class="bus-map_off_actions">
            <button class="bus-map_off_button" type="button" data-trigger="hover focus">Kaart aanzetten</button>
            <a class="bus-map_off_link u-text-style-small" href={url('referenties')}>Bekijk onze klussen</a>
          </div>
        </div>
      </div>
      <div class="bus-map_canvas" role="group" aria-label={`Kaart van ${region ? region.naam : 'Drenthe, Groningen en Friesland'} met onze klussen`}></div>
    </div>
  </div>
  <div class="bus-map_pins" aria-hidden="true">
    {casePins.map((pin) => (
      <button class="bus-map_pin is-case" type="button" aria-label={`${pin.naam}, bekijk deze klus`} data-trigger="hover focus" data-index={pin.index} data-lat={pin.lat} data-lng={pin.lng} data-naam={pin.naam}></button>
    ))}
    {dots.map((pin) => (
      <span class="bus-map_pin" aria-hidden="true" data-lat={pin.lat} data-lng={pin.lng} data-naam={pin.naam}></span>
    ))}
    {referenties.map((item, index) => (
      <div class="bus-map_card" data-index={index}>
        {item.fotoUrl && <img class="bus-map_card_img" src={item.fotoUrl} alt={item.fotoAlt ?? ''} loading="lazy" />}
        <div class="bus-map_card_body">
          <h3 class="bus-map_card_title u-text-style-bus-title">{item.titel}</h3>
          <p class="bus-map_card_text u-text-style-small">
            {item.gelegenheid} in {item.plaats}{item.gasten && `, ${item.gasten} gasten`}. {kort(item.verhaal)}
          </p>
          {casePaginas[item.slug] && (
            <a class="bus-map_link u-text-style-main" href={url(casePaginas[item.slug])} data-trigger="hover focus">
              Lees het hele verhaal
              <svg class="bus-map_link_icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.500 8h10M8.500 3.500 13 8l-4.500 4.500" stroke="currentColor" stroke-width="2.500" /></svg>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .bus-map_wrap {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .bus-map_layout {
    display: var(--flex-medium, grid);
    flex-direction: column;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--_spacing---space--6) var(--site--gutter);
  }
  /* Stacked, the map comes right after the intro and the towns close the section. */
  .bus-map_side {
    grid-column: 1 / span 5;
    display: var(--contents-medium, flex);
    flex-flow: column;
    gap: var(--_spacing---space--6);
    width: 100%;
    padding-right: var(--_spacing---space--6);
  }
  .bus-map_intro {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--4);
  }
  /* Only there when the script runs and the map can load. Grows along with the side column. */
  .bus-map_canvas {
    grid-column: 6 / span 7;
    display: none;
    width: 100%;
    min-height: var(--size--map);
    background-color: var(--_theme---background-2);
    border-top-right-radius: var(--radius--shape);
    overflow: clip;
  }
  .bus-map_canvas.is-active { display: block; }
  .bus-map_off {
    grid-column: 6 / span 7;
    display: none;
    flex-flow: column;
    justify-content: space-between;
    gap: var(--_spacing---space--4);
    width: 100%;
    min-height: var(--size--map);
    padding: var(--_spacing---space--5);
    background-color: var(--_theme---background-2);
    border-top-right-radius: var(--radius--shape);
  }
  .bus-map_off.is-active { display: flex; }
  .bus-map_off_drawing {
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
  }
  .bus-map_off_province {
    fill: var(--color--bus-green);
    fill-opacity: 0.08;
    stroke: var(--color--bus-green);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .bus-map_off_pin {
    fill: var(--color--bus-yellow);
    stroke: var(--color--bus-green);
    stroke-width: 5;
  }
  .bus-map_off_body {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--2);
  }
  .bus-map_off_text { max-width: 54ch; }
  .bus-map_off_actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--_spacing---space--2) var(--_spacing---space--5);
  }
  .bus-map_off_button {
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--4);
    background-color: color-mix(in hsl, var(--color--bus-green) calc(100% * var(--_trigger---on)), var(--color--bus-black) calc(100% * var(--_trigger---off)));
    color: var(--color--white);
    border: none;
    font-family: var(--_typography---font--heading);
    font-stretch: var(--_typography---stretch--poster);
    font-weight: var(--_typography---font--primary-bold);
    cursor: pointer;
  }
  .bus-map_off_link {
    display: inline-flex;
    align-items: center;
    min-height: var(--target--min);
    color: inherit;
  }
  .bus-map_regions {
    display: flex;
    flex-flow: column;
    order: var(--last-medium, 0);
  }
  .bus-map_region {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--2);
    padding-block: var(--_spacing---space--5);
    border-top: var(--border-width--main) solid var(--_theme---divider);
  }
  .bus-map_link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--_spacing---space--2);
    min-height: var(--target--min);
    color: var(--_theme---text);
    text-decoration: none;
  }
  /* The arrow marks the link and comes forward on hover and focus. */
  .bus-map_link_icon {
    flex-shrink: 0;
    width: var(--size--link-arrow);
    height: var(--size--link-arrow);
    opacity: calc(0.6 * var(--_trigger---on) + var(--_trigger---off));
    transform: translateX(calc(var(--_spacing---space--2) * var(--_trigger---off)));
  }
  @media (prefers-reduced-motion: no-preference) {
    .bus-map_link_icon { transition: opacity 150ms, transform 150ms; }
  }
  .bus-map_tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--_spacing---space--2);
  }
  .bus-map_tag_item.is-hidden { display: none; }
  .bus-map_more_item { display: none; }
  .bus-map_more_item.is-active { display: block; }
  .bus-map_more {
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--1);
    background: none;
    color: inherit;
    border: none;
    text-decoration: underline;
    cursor: pointer;
  }
  .bus-map_tag {
    display: inline-flex;
    align-items: center;
    min-height: var(--target--small);
    padding-inline: var(--_spacing---space--2);
    background-color: var(--_theme---background-2);
  }
  .bus-map_tag.is-link {
    color: color-mix(in hsl, var(--_theme---text) calc(100% * var(--_trigger---on)), var(--color--white) calc(100% * var(--_trigger---off)));
    background-color: color-mix(in hsl, var(--_theme---background-2) calc(100% * var(--_trigger---on)), var(--color--bus-green) calc(100% * var(--_trigger---off)));
    text-decoration: underline;
    transition: background-color 150ms, color 150ms;
  }
  .bus-map_pins { display: none; }
  .bus-map_pin {
    display: block;
    width: var(--size--map-dot);
    height: var(--size--map-dot);
    padding: 0;
    background-color: var(--color--bus-green);
    border: var(--border-width--main) solid var(--color--white);
    border-radius: var(--radius--round);
  }
  .bus-map_pin.is-case {
    width: var(--size--map-pin-large);
    height: var(--size--map-pin-large);
    background-color: color-mix(in hsl, var(--color--bus-yellow) calc(100% * var(--_trigger---on)), var(--color--bus-green) calc(100% * var(--_trigger---off)));
    border: var(--focus--width) solid var(--color--bus-green);
    cursor: pointer;
  }
  /* A tap target of the full minimum size around the small pin. */
  .bus-map_pin.is-case::before {
    content: '';
    position: absolute;
    inset: calc((var(--size--map-pin-large) - var(--target--min)) / 2);
  }
  .bus-map_pin.is-active {
    background-color: var(--color--bus-green);
    border-color: var(--color--bus-yellow);
  }
  .bus-map_card {
    display: flex;
    flex-flow: column;
    width: min(var(--size--map-card), 70vw);
    color: var(--_theme---text);
  }
  .bus-map_card_img {
    width: 100%;
    height: var(--size--map-card-img);
    object-fit: cover;
  }
  .bus-map_card_body {
    display: flex;
    flex-flow: column;
    gap: var(--_spacing---space--2);
    padding: var(--_spacing---space--4);
    padding-right: var(--target--min);
  }
  .bus-map_card_text { margin: 0; }
</style>

<style is:global>
  /* The map library renders these itself, so they cannot carry our classes. */
  .bus-map_canvas .maplibregl-ctrl-group { border-radius: 0; box-shadow: none; }
  .bus-map_canvas .maplibregl-ctrl-group button {
    width: var(--target--min);
    height: var(--target--min);
  }
  .bus-map_canvas .maplibregl-ctrl-attrib {
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  .bus-map_canvas .maplibregl-ctrl-attrib a { color: inherit; }
  .bus-map_canvas .maplibregl-popup-content {
    padding: 0;
    background-color: var(--_theme---background);
    border-top: var(--focus--width) solid var(--color--bus-yellow);
    border-radius: 0;
  }
  .bus-map_canvas .maplibregl-popup-anchor-bottom .maplibregl-popup-tip { border-top-color: var(--_theme---background); }
  .bus-map_canvas .maplibregl-popup-close-button {
    width: var(--target--min);
    height: var(--target--min);
    background-color: var(--_theme---background);
    color: var(--_theme---text);
    font-size: var(--_typography---size--h3);
  }
</style>

<script>
  import { CONSENT_EVENT, allowOnly, readConsent } from '../../lib/consent';

  document.querySelectorAll<HTMLElement>('.bus-map_wrap').forEach((root) => {
    const canvas = root.querySelector<HTMLElement>('.bus-map_canvas');
    const off = root.querySelector<HTMLElement>('.bus-map_off');
    const offButton = root.querySelector<HTMLElement>('.bus-map_off_button');
    if (!canvas || !off || !offButton) return;

    // At most two rows of towns, however wide the column is. The rest opens with
    // a text link, and without the script all towns simply stay in view.
    root.querySelectorAll<HTMLElement>('.bus-map_tags').forEach((list) => {
      const items = [...list.querySelectorAll<HTMLElement>('.bus-map_tag_item')];
      const moreItem = list.querySelector<HTMLElement>('.bus-map_more_item');
      const more = list.querySelector<HTMLElement>('.bus-map_more');
      if (!moreItem || !more) return;
      let open = false;
      let width = 0;
      const rows = () => new Set([...items, moreItem].filter((item) => item.offsetParent).map((item) => item.offsetTop)).size;
      const fit = () => {
        items.forEach((item) => item.classList.remove('is-hidden'));
        moreItem.classList.remove('is-active');
        more.setAttribute('aria-expanded', String(open));
        if (rows() <= 2) return;
        moreItem.classList.add('is-active');
        more.textContent = 'Minder';
        if (open) return;
        for (let hidden = 1; hidden <= items.length && rows() > 2; hidden += 1) {
          items[items.length - hidden].classList.add('is-hidden');
          more.textContent = `en ${hidden} meer`;
        }
      };
      more.addEventListener('click', () => {
        open = !open;
        fit();
      });
      new ResizeObserver(() => {
        if (list.clientWidth === width) return;
        width = list.clientWidth;
        fit();
      }).observe(list);
      document.fonts.ready.then(fit);
    });
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pinElements = [...root.querySelectorAll<HTMLElement>('.bus-map_pin')];
    const cards = [...root.querySelectorAll<HTMLElement>('.bus-map_card')];

    const start = async () => {
      const [{ default: maplibre }, { default: alleProvincies }, response] = await Promise.all([
        import('maplibre-gl'),
        import('../../data/provincies-noord.json'),
        fetch('https://tiles.openfreemap.org/styles/positron'),
        import('maplibre-gl/dist/maplibre-gl.css'),
      ]);
      const style = await response.json();

      // The map in the colors of the site, read from the tokens.
      const color = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(`--color--${name}`).trim();
      const land = color('marigold-2');
      const verborgen = /building|aeroway|railway|shield|airport|highway-name|road_|tunnel|ice|glacier|water_name|waterway_line_label|label_other|boundary/;
      style.layers.forEach((layer: { id: string; type: string; paint?: Record<string, unknown>; layout?: Record<string, unknown> }) => {
        const { id, type } = layer;
        if (verborgen.test(id)) {
          layer.layout = { ...layer.layout, visibility: 'none' };
        } else if (type === 'background') {
          layer.paint = { 'background-color': land };
        } else if (type === 'fill') {
          const fill = id === 'water' ? color('camarone-2') : id.startsWith('landuse') ? color('marigold-1') : color('camarone-1');
          layer.paint = { ...layer.paint, 'fill-color': fill, 'fill-opacity': 1 };
        } else if (type === 'line') {
          const line = id.startsWith('waterway') ? color('camarone-2') : id.includes('casing') ? color('marigold-3') : color('white');
          layer.paint = { ...layer.paint, 'line-color': line };
        } else if (type === 'symbol') {
          layer.paint = { ...layer.paint, 'text-color': color('bus-black'), 'text-halo-color': land };
        }
      });

      // The provinces, lightly drawn under the place names. On a local page only
      // that one, with everything around it faded.
      const naam = root.dataset.provincie;
      const gekozen = alleProvincies.features.filter((feature) => !naam || feature.properties.naam === naam);
      const provincies = { ...alleProvincies, features: gekozen };
      style.sources.provincies = { type: 'geojson', data: provincies, attribution: 'Provincies: CBS, Kadaster' };
      const labels = style.layers.findIndex((layer: { type: string }) => layer.type === 'symbol');
      style.layers.splice(
        labels,
        0,
        { id: 'provincies-vlak', type: 'fill', source: 'provincies', paint: { 'fill-color': color('bus-green'), 'fill-opacity': 0.08 } },
        { id: 'provincies-lijn', type: 'line', source: 'provincies', paint: { 'line-color': color('bus-green'), 'line-width': 1.5, 'line-opacity': 0.55 } },
      );
      if (naam) {
        const gaten = gekozen.flatMap(({ geometry }) => (geometry.type === 'Polygon' ? [geometry.coordinates[0]] : (geometry.coordinates as unknown as number[][][][]).map((vlak) => vlak[0])));
        style.sources.buiten = { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [[[0, 50], [12, 50], [12, 56], [0, 56], [0, 50]], ...gaten] } } };
        style.layers.push({ id: 'buiten-vlak', type: 'fill', source: 'buiten', paint: { 'fill-color': color('marigold-1'), 'fill-opacity': 0.75 } });
      }

      const map = new maplibre.Map({
        container: canvas,
        style,
        center: [6.3, 53.05],
        zoom: 8,
        minZoom: 6,
        maxZoom: 13,
        dragRotate: false,
        touchPitch: false,
        cooperativeGestures: true,
        attributionControl: { compact: false },
        fadeDuration: still ? 0 : 300,
        locale: {
          'NavigationControl.ZoomIn': 'Zoom in',
          'NavigationControl.ZoomOut': 'Zoom uit',
          'CooperativeGesturesHandler.WindowsHelpText': 'Houd Ctrl ingedrukt en scroll om te zoomen',
          'CooperativeGesturesHandler.MacHelpText': 'Houd ⌘ ingedrukt en scroll om te zoomen',
          'CooperativeGesturesHandler.MobileHelpText': 'Gebruik twee vingers om de kaart te bewegen',
          'Popup.Close': 'Sluiten',
        },
      });
      map.addControl(new maplibre.NavigationControl({ showCompass: false }), 'top-left');

      // One card at a time, standing on its pin.
      const popup = new maplibre.Popup({ anchor: 'bottom', offset: 16, maxWidth: 'none', focusAfterOpen: false });
      let openPin: HTMLElement | undefined;
      popup.on('close', () => {
        const pin = openPin;
        openPin = undefined;
        pin?.classList.remove('is-active');
        // The close button is gone with the card, so the keyboard goes back to the pin.
        if (document.activeElement === document.body) pin?.focus({ preventScroll: true });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && openPin) popup.remove();
      });
      const open = (pin: HTMLElement, point: [number, number], viaKeyboard: boolean) => {
        const card = cards.find((item) => item.dataset.index === pin.dataset.index);
        if (!card) return;
        if (openPin === pin) {
          popup.remove();
          return;
        }
        openPin?.classList.remove('is-active');
        openPin = pin;
        pin.classList.add('is-active');
        popup.setLngLat(point).setDOMContent(card);
        if (!popup.isOpen()) popup.addTo(map);
        if (viaKeyboard) popup.getElement().querySelector<HTMLElement>('a, button')?.focus({ preventScroll: true });
        // The pin moves down, so the card on top of it fits in the map.
        map.easeTo({ center: point, offset: [0, canvas.clientHeight * 0.3], animate: !still });
      };

      const eigen = root.dataset.bounds ? (JSON.parse(root.dataset.bounds) as [[number, number], [number, number]]) : null;
      const bounds = eigen ? new maplibre.LngLatBounds(eigen[0], eigen[1]) : new maplibre.LngLatBounds([5.3, 52.62], [7.25, 53.48]);
      pinElements.forEach((element) => {
        const point: [number, number] = [Number(element.dataset.lng), Number(element.dataset.lat)];
        bounds.extend(point);
        element.title = element.dataset.naam ?? '';
        new maplibre.Marker({ element }).setLngLat(point).addTo(map);
        if (element.dataset.index === undefined) return;
        element.addEventListener('click', (event) => {
          // Otherwise the map takes this click as one next to the card and closes it.
          event.stopPropagation();
          // A click without a pointer has detail 0: that is Enter or Space.
          open(element, point, event.detail === 0);
        });
      });
      map.fitBounds(bounds, { padding: 24, duration: 0 });
    };

    // First load when it comes near the screen, so the page itself stays light.
    const load = () => new IntersectionObserver((entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      start().catch((error) => {
        console.warn('Map not available, the rest of the section stays:', error);
        canvas.classList.remove('is-active');
        off.classList.add('is-active');
      });
    }, { rootMargin: '400px' }).observe(root);

    let loaded = false;
    const apply = () => {
      const allowed = readConsent()?.media === true;
      // A yes taken back: a fresh page is the only sure way to stop the map.
      if (loaded && !allowed) window.location.reload();
      off.classList.toggle('is-active', !allowed);
      if (allowed && !loaded) {
        loaded = true;
        canvas.classList.add('is-active');
        load();
      }
    };
    offButton.addEventListener('click', () => allowOnly('media'));
    document.addEventListener(CONSENT_EVENT, apply);
    apply();
  });
</script>
