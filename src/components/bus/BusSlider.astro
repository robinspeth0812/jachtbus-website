---
// Row of photos that starts on the container and runs off the right edge of the
// page: one whole photo, the next one half. Swipes and scrolls natively, the
// script only adds the automatic advance and its pause button.
import { Image } from 'astro:assets';
import type { Photo } from '../../data/nieuw';

interface Slide {
  /** The photo and its alt text. */
  photo: Photo;
  /** Focal point, as a CSS object-position. */
  focus?: string;
}
interface Props {
  /** The photos, at least four so the row always fills the page. */
  slides: Slide[];
  /** Name of the slider for screen readers. */
  label?: string;
  /** Load the first photos right away, for a slider in the first screen. */
  eager?: boolean;
}
const { slides, label = 'Foto\'s van de Jachtbus', eager = false } = Astro.props;
---

<div class="bus-slider_wrap" role="group" aria-roledescription="carrousel" aria-label={label}>
  <ul class="bus-slider_track" tabindex="0" aria-label={label}>
    {slides.map((slide, index) => (
      <li class="bus-slider_slide">
        <Image
          class="bus-slider_img"
          src={slide.photo.src}
          alt={slide.photo.alt}
          widths={[480, 800, 1200, 1500].filter((width) => width <= slide.photo.src.width)}
          sizes="(max-width: 50em) 80vw, 66vw"
          loading={eager && index < 2 ? 'eager' : 'lazy'}
          fetchpriority={eager && index === 0 ? 'high' : undefined}
          style={`object-position: ${slide.focus ?? '50% 50%'};`}
        />
      </li>
    ))}
  </ul>
  <button class="bus-slider_toggle u-text-style-small" type="button" data-trigger="hover focus">
    <svg class="bus-slider_icon is-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2h4v12H3zM9 2h4v12H9z" fill="currentColor" /></svg>
    <svg class="bus-slider_icon is-play" viewBox="0 0 16 16" aria-hidden="true" hidden><path d="M3 1.500v13l11-6.500z" fill="currentColor" /></svg>
    <span class="bus-slider_label">Pauzeer de foto's</span>
  </button>
</div>

<style>
  .bus-slider_wrap {
    --_inset: max(var(--site--margin), calc((100% - var(--max-width--main)) / 2));
    /* How many photos fit from the container edge to the page edge. */
    --_visible: calc(var(--_responsive---large) * 1.5 + (1 - var(--_responsive---large)) * 1.25);
    position: relative;
  }
  .bus-slider_track {
    position: relative;
    display: flex;
    gap: var(--site--gutter);
    padding-inline-start: var(--_inset);
    scroll-padding-inline-start: var(--_inset);
    scroll-snap-type: x mandatory;
    overflow-x: auto;
    scrollbar-width: none;
    outline-offset: calc(var(--focus--width) * -1);
  }
  .bus-slider_slide {
    flex: 0 0 calc((100% - var(--site--gutter)) / var(--_visible));
    scroll-snap-align: start;
    background-color: var(--_theme---background-skeleton);
  }
  .bus-slider_img {
    aspect-ratio: calc(var(--_responsive---large) * 1.6 + (1 - var(--_responsive---large)) * 1.25);
    height: auto;
  }
  /* Only there when the script runs and motion is welcome. */
  .bus-slider_toggle {
    display: none;
    position: absolute;
    left: calc(var(--_inset) + var(--_spacing---space--3));
    bottom: var(--_spacing---space--3);
    align-items: center;
    gap: var(--_spacing---space--2);
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--3);
    background-color: color-mix(in hsl, var(--color--bus-green) calc(100% * var(--_trigger---on)), var(--color--bus-black) calc(100% * var(--_trigger---off)));
    color: var(--color--white);
    border: none;
    cursor: pointer;
    transition: background-color 150ms;
  }
  .bus-slider_toggle.is-active { display: inline-flex; }
  .bus-slider_icon {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
  }
</style>

<script>
  const INTERVAL = 5000;

  document.querySelectorAll<HTMLElement>('.bus-slider_wrap').forEach((root) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const track = root.querySelector<HTMLElement>('.bus-slider_track');
    const toggle = root.querySelector<HTMLElement>('.bus-slider_toggle');
    const label = root.querySelector<HTMLElement>('.bus-slider_label');
    const pauseIcon = root.querySelector<SVGElement>('.bus-slider_icon.is-pause');
    const playIcon = root.querySelector<SVGElement>('.bus-slider_icon.is-play');
    if (!track || !toggle || !label || !pauseIcon || !playIcon) return;

    let paused = false;
    let held = false;
    let inView = true;
    new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; }).observe(track);

    const startOf = (slide: Element) => (slide as HTMLElement).offsetLeft - (track.firstElementChild as HTMLElement).offsetLeft;

    const advance = () => {
      if (paused || held || !inView || document.hidden) return;
      // Slides already passed go to the back, so the row never runs out.
      const slides = [...track.children];
      const current = slides.reduce((best, slide, index) =>
        Math.abs(startOf(slide) - track.scrollLeft) < Math.abs(startOf(slides[best]) - track.scrollLeft) ? index : best, 0);
      track.append(...slides.slice(0, current));
      track.scrollTo({ left: 0, behavior: 'instant' });
      track.scrollTo({ left: startOf(track.children[1]), behavior: 'smooth' });
    };
    window.setInterval(advance, INTERVAL);

    // Reading or touching the row holds it, the button stops it for good.
    root.addEventListener('pointerenter', () => { held = true; });
    root.addEventListener('pointerleave', () => { held = false; });
    root.addEventListener('focusin', () => { held = true; });
    root.addEventListener('focusout', () => { held = false; });

    toggle.classList.add('is-active');
    toggle.addEventListener('click', () => {
      paused = !paused;
      label.textContent = paused ? "Speel de foto's af" : "Pauzeer de foto's";
      pauseIcon.toggleAttribute('hidden', paused);
      playIcon.toggleAttribute('hidden', !paused);
    });
  });
</script>
