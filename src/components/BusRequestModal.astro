---
// Request form in a dialog for the /branding-2 proposal: a centered panel
// from tablet up, full screen on phones. Every link to /aanvraag on the page
// opens it, so without JS those links still reach the form page.
import RequestForm from './RequestForm.astro';
---

<dialog class="bus-modal_wrap u-theme-bus-beige" aria-labelledby="bus-modal-title">
  <div class="bus-modal_bar u-theme-bus-green">
    <h2 class="bus-modal_title u-text-style-poster-label" id="bus-modal-title" tabindex="-1" autofocus>Je aanvraag</h2>
    <button class="bus-modal_close" type="button" aria-label="Sluit je aanvraag" data-trigger="hover focus">
      <svg class="bus-modal_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 5 19 19M19 5 5 19" stroke="currentColor" stroke-width="3" stroke-linecap="square" />
      </svg>
    </button>
  </div>
  <div class="bus-modal_stripe"></div>
  <div class="bus-modal_body">
    <RequestForm variant="modal" />
    <p class="bus-modal_text u-text-style-small">
      Liever even bellen? <a class="bus-modal_link" href="tel:+31592656363">0592 656363</a>
    </p>
  </div>
</dialog>

<style>
  /* Phones get the whole screen: the size flags switch at the small band. */
  .bus-modal_wrap {
    --_panel: calc(var(--_responsive---large) + var(--_responsive---medium));
    display: none;
    flex-flow: column;
    width: calc(var(--size--modal) * var(--_panel) + 100% * (1 - var(--_panel)));
    max-width: 100%;
    min-height: calc(100dvh * (1 - var(--_panel)));
    max-height: calc(var(--size--modal-max-height) * var(--_panel) + 100dvh * (1 - var(--_panel)));
    margin: auto;
    padding: 0;
    border: none;
    overflow: clip;
    background-color: var(--_theme---background);
    color: var(--_theme---text);
    text-wrap: pretty;
    opacity: 0;
    transform: translateY(var(--_spacing---space--5));
    transition: opacity 200ms, transform 300ms cubic-bezier(0.16, 1, 0.3, 1), display 300ms allow-discrete, overlay 300ms allow-discrete;
  }
  .bus-modal_wrap:modal {
    display: flex;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .bus-modal_wrap:modal {
      opacity: 0;
      transform: translateY(var(--_spacing---space--5));
    }
  }
  .bus-modal_wrap::backdrop {
    background-color: color-mix(in hsl, var(--color--bus-black) 70%, transparent);
  }
  .bus-modal_bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--_spacing---space--4);
    flex-shrink: 0;
    padding: var(--_spacing---space--3) var(--_spacing---space--3) var(--_spacing---space--3) var(--_spacing---space--5);
    background-color: var(--_theme---background);
    color: var(--_theme---text);
  }
  /* Only receives focus when the dialog opens, so it is announced. */
  .bus-modal_title { outline: none; }
  .bus-modal_close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target--min);
    height: var(--target--min);
    flex-shrink: 0;
    padding: 0;
    border: none;
    background-color: color-mix(in hsl, transparent calc(100% * var(--_trigger---on)), var(--_theme---background-2) calc(100% * var(--_trigger---off)));
    color: var(--_theme---text);
    cursor: pointer;
    transition: background-color 200ms;
  }
  .bus-modal_icon {
    width: var(--size--modal-icon);
    height: var(--size--modal-icon);
  }
  .bus-modal_stripe {
    flex-shrink: 0;
    height: var(--size--stripe);
    background-color: var(--color--bus-yellow);
  }
  .bus-modal_body {
    display: flex;
    flex-flow: column;
    flex: 1 1 auto;
    gap: var(--_spacing---space--5);
    min-height: 0;
    padding: var(--_spacing---space--5);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: var(--_theme---border) transparent;
  }
  /* Sits at the bottom of the full screen phone version. */
  .bus-modal_text { margin-top: auto; }
  .bus-modal_link { color: var(--_theme---text-link--text); }
</style>

<script>
  document.querySelectorAll<HTMLDialogElement>('.bus-modal_wrap').forEach((dialog) => {
    const form = dialog.querySelector<HTMLFormElement>('.aanvraag_form_wrap');
    const close = dialog.querySelector<HTMLButtonElement>('.bus-modal_close');
    if (!form || !close || typeof dialog.showModal !== 'function') return;

    // Delegated from the document: the links live all over the page. New-tab
    // clicks keep going to the form page.
    const open = (occasion: string | null, date: string | null) => {
      form.dispatchEvent(new CustomEvent('aanvraag:open', { detail: { occasion, date } }));
      dialog.showModal();
    };
    document.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="/aanvraag"], a[href^="/nieuw/aanvraag"]');
      if (!link) return;
      event.preventDefault();
      open(new URL(link.href).searchParams.get('gelegenheid'), null);
    });
    // Sent by the date check in the hero.
    document.addEventListener('aanvraag:start', (event) => {
      const { occasion, date } = (event as CustomEvent<{ occasion: string | null; date: string | null }>).detail;
      open(occasion, date);
    });

    close.addEventListener('click', () => dialog.close());
    // A click outside the panel lands on the dialog itself. Answers stay in
    // the form, so closing this way loses nothing.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
