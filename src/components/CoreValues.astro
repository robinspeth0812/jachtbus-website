---
// The three core values, set up like the Brasserie Jachtlust section
// but in Jachtbus style: heading left with the intro (plus handwritten
// signature) right, below that three columns. Each value is itself a
// two-column row: a narrow icon column, with the title and text stacked
// next to it. No underline under the headings.
interface Props {
  /** Section heading. */
  title?: string;
  /** Intro paragraph, shown to the right of the heading. */
  text?: string;
  /** Handwritten signature under the intro; empty hides it. */
  signature?: string;
  /** Full section, or the compact bar under a hero. */
  variant?: 'full' | 'bar';
}
const {
  title = 'Onze kernwaarden',
  text = 'Bij ons draait alles om lokaal, eerlijk en voedzaam voedsel. We kiezen voor lokale producten om de economie te steunen en respect voor iedereen in de keten te waarborgen.',
  signature = 'Peer Wagenaar',
  variant = 'full',
} = Astro.props;

const values = [
  {
    icon: 'pin',
    title: 'Lokaal verkregen',
    text: 'Waar mogelijk maken wij gebruik van regionale producten van nauwkeurig uitgekozen partners.',
  },
  {
    icon: 'leaf',
    title: 'Eerlijke producten',
    text: "Wij geloven in eerlijke, schone, goede producten. Geen 'gerommel' en onnodige toevoegingen. Eerlijk eten telt!",
  },
  {
    icon: 'tree',
    title: 'Ambachtelijk bereid',
    text: '90% van ons voedsel bereiden we zelf. Anders vertrouwen we op ambachtelijke partners binnen onze waarden.',
  },
];

const iconPaths: Record<string, string> = {
  pin: 'M8 1.5c-2.7 0-4.8 2.1-4.8 4.8 0 3.6 4.8 8.2 4.8 8.2s4.8-4.6 4.8-8.2c0-2.7-2.1-4.8-4.8-4.8Zm0 6.5a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4Z',
  leaf: 'M13.8 2.2c-7 .3-10.9 3.7-11.6 9.8-.1.9.1 1.7.5 2.3l1.2-1.1c2.6-4.6 5.9-6.9 8.2-7.9-2.9 2-5.6 4.7-7.3 8.2.7.4 1.6.6 2.6.5 6-.6 6.9-6.1 6.4-11.8Z',
  tree: 'M8 1.5a4.4 4.4 0 0 0-4.3 5.4 3 3 0 0 0 .9 5.8h2.5v1.8h1.8v-1.8h2.5a3 3 0 0 0 .9-5.8A4.4 4.4 0 0 0 8 1.5Z',
};
---

{
  variant === 'bar' && (
    <aside class="values_bar_wrap u-theme-soft">
      <div class="values_bar_contain u-container">
        <ul class="values_bar_list">
          {values.map((value) => (
            <li class="values_bar_item">
              <svg class="values_bar_icon" aria-hidden="true" viewBox="0 0 16 16">
                <path fill="currentColor" fill-rule="evenodd" d={iconPaths[value.icon]} />
              </svg>
              <span class="values_bar_text u-text-style-h6">{value.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

{variant === 'full' && (
<section class="values_wrap u-section u-theme-light">
  <div class="values_contain u-container">
    <div class="values_header_layout">
      <div class="values_title u-heading u-text-style-h2">
        <h2>{title}</h2>
      </div>
      <div class="values_intro u-margin-trim">
        <p class="values_text u-text-style-main">{text}</p>
        {signature && <p class="values_signature u-text-style-accent u-text-style-h5">{signature}</p>}
      </div>
    </div>
    <div class="values_layout">
      {
        values.map((value) => (
          <div class="values_item">
            <svg class="values_item_icon" aria-hidden="true" viewBox="0 0 16 16">
              <path fill="currentColor" fill-rule="evenodd" d={iconPaths[value.icon]} />
            </svg>
            <div class="values_item_content u-margin-trim">
              <h3 class="values_item_title u-text-style-h5">{value.title}</h3>
              <p class="values_item_text u-text-style-main">{value.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
)}

<style>
  .values_bar_wrap {
    display: flex;
    flex-flow: column;
    background-color: var(--_theme---background);
    color: var(--_theme---text);
    padding-top: var(--_spacing---space--3);
    padding-bottom: var(--_spacing---space--3);
    border-bottom: var(--border-width--main) solid var(--_theme---border);
  }
  .values_bar_list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--_spacing---space--2) var(--_spacing---space--7);
  }
  .values_bar_item {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
  }
  .values_bar_icon {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
    color: var(--_theme---text-accent);
    flex-shrink: 0;
  }
  .values_header_layout {
    display: var(--flex-medium, grid);
    flex-direction: column;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--_spacing---space--5) var(--_spacing---space--8);
  }
  .values_title {
    display: flex;
    max-width: 20ch;
  }
  .values_intro {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--3);
    max-width: 55ch;
  }
  .values_signature { color: var(--_theme---text-accent); }
  .values_layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--_spacing---space--6) var(--_spacing---space--8);
  }
  /* Each value: narrow icon column, title and text stacked beside it. */
  .values_item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--_spacing---space--3);
    align-items: start;
  }
  .values_item_icon {
    width: var(--_spacing---space--5);
    height: var(--_spacing---space--5);
    color: var(--_theme---text-accent);
    /* Optically align with the cap height of the title beside it. */
    margin-top: calc(var(--_spacing---space--1) / 2);
  }
  .values_item_content {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--2);
  }
  .values_item_text { max-width: 40ch; }
</style>
