---
// Multi-step request form (4 steps): occasion, date and moments,
// location and guests, contact. Progressive enhancement: without JS it
// renders as one long working form; JS turns it into steps with
// progress, per-step validation, draft saving, and prefill via the
// ?gelegenheid= parameter. Posts to the endpoint from
// PUBLIC_AANVRAAG_ENDPOINT (the Resend key lives outside this repo);
// without an endpoint the submit shows the direct-contact fallback.
import ChatBubble from './ChatBubble.astro';
import { url } from '../data/nieuw';
import { getInhoud } from '../lib/cms';

interface Props {
  /** Where the form lives: 'page' renders a full section with its own
      card, 'embedded' strips section spacing and card chrome so the
      form sits inside an existing card (e.g. the home hero), 'modal'
      also drops the fixed theme so it follows the surrounding dialog. */
  variant?: 'page' | 'embedded' | 'modal';
}
const { variant = 'page' } = Astro.props;

const endpoint = import.meta.env.PUBLIC_AANVRAAG_ENDPOINT ?? '';
// A few earlier parties for the thank-you screen; the script shows two, the same occasion first.
const { referenties } = await getInhoud();
const cases = referenties.slice(0, 12);
const isModal = variant === 'modal';
const stepTitleStyle = isModal ? 'u-text-style-poster-label' : 'u-text-style-h4';
const buttonTrigger = isModal ? 'hover focus' : undefined;

const occasions = [
  { value: 'bruiloft', label: 'Bruiloft' },
  { value: 'bedrijfsfeest', label: 'Bedrijfsfeest' },
  { value: 'tuinfeest', label: 'Tuinfeest' },
  { value: 'evenement', label: 'Evenement' },
  { value: 'festival', label: 'Festival' },
  { value: 'bbq', label: 'BBQ' },
  { value: 'verjaardag', label: 'Verjaardag' },
  { value: 'jubileum', label: 'Jubileum' },
  { value: 'overige', label: 'Overige' },
];
const stepLabels = ['Gelegenheid', 'Datum', 'Locatie', 'Contact'];
const momentOptions = [
  { value: 'borrel', label: 'De borrel' },
  { value: 'diner', label: 'Het diner' },
  { value: 'avondsnack', label: 'De avondsnack' },
];
// Place suggestions for the location field: towns in the service area,
// served through a native datalist (free, offline, no API key).
const places = [
  'Assen', 'Groningen', 'Leeuwarden', 'Emmen', 'Hoogeveen', 'Meppel',
  'Drachten', 'Roden', 'Sneek', 'Heerenveen', 'Coevorden', 'Stadskanaal',
  'Veendam', 'Winschoten', 'Delfzijl', 'Hoogezand', 'Leek', 'Zuidlaren',
  'Gieten', 'Gasselte', 'Rolde', 'Beilen', 'Westerbork', 'Dwingeloo',
  'Diever', 'Norg', 'Vries', 'Eelde', 'Peize', 'Annen', 'Borger',
  'Klazienaveen', 'Dalen', 'Zuidwolde', 'Ruinen', 'Havelte', 'Franeker',
  'Harlingen', 'Bolsward', 'Joure', 'Lemmer', 'Wolvega', 'Gorredijk',
  'Burgum', 'Dokkum', 'Kollum', 'Surhuisterveen', 'Grou', 'Akkrum',
  'Appingedam', 'Winsum', 'Zuidhorn', 'Uithuizen', 'Haren', 'Paterswolde',
  'Schoonoord', 'Sleen', 'Exloo', 'Odoorn', 'Nieuw-Amsterdam', 'Stiens',
  'Wedde', 'De Wilp', 'Eeserveen', 'Een', 'Drouwen', 'Nooitgedacht',
  'Oudemolen', 'Gasselternijveen',
];
---

<section
  class:list={['aanvraag_wrap', variant === 'page' && 'u-section', !isModal && 'u-theme-light']}
  data-aanvraag-form
>
  <div class:list={['aanvraag_contain', variant === 'page' && 'u-container']}>
    <form
      class:list={['aanvraag_form_wrap', !isModal && 'u-theme-soft', variant === 'embedded' && 'is-embedded', isModal && 'is-modal']}
      method="post"
      action={endpoint}
      data-endpoint={endpoint}
    >
      <ol class="aanvraag_steps_nav" hidden>
        {
          stepLabels.map((label, index) => (
            <li class:list={['aanvraag_steps_item', index === stepLabels.length - 1 && 'is-last']}>
              <button
                class="aanvraag_steps_btn"
                type="button"
                data-step={index}
                aria-label={`Stap ${index + 1}: ${label}`}
              >
                <span class="aanvraag_steps_num">{index + 1}</span>
                <svg class="aanvraag_steps_check" viewBox="0 0 16 16" aria-hidden="true" fill="none">
                  <path d="M3.5 8.5 6.5 11.5 12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              {index < stepLabels.length - 1 && (
                <span class="aanvraag_steps_line" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>

      <fieldset class="aanvraag_step is-1">
        <legend class:list={['aanvraag_step_title', stepTitleStyle]}>Waarvoor zoek je een foodtruck?</legend>
        <div class="aanvraag_options_grid">
          {
            occasions.map((occasion) => (
              <label class="aanvraag_option_wrap is-tile">
                <input
                  class="aanvraag_option_input"
                  type="radio"
                  name="gelegenheid"
                  value={occasion.value}
                  required
                />
                <span class="aanvraag_option_text">{occasion.label}</span>
              </label>
            ))
          }
        </div>
        <div class="aanvraag_field_wrap is-overig">
          <label class="aanvraag_label" for="aanvraag-overig">Waarvoor dan? Vertel het kort</label>
          <input class="aanvraag_input" type="text" id="aanvraag-overig" name="gelegenheid_overig" />
        </div>
      </fieldset>

      <fieldset class="aanvraag_step is-2">
        <legend class:list={['aanvraag_step_title', stepTitleStyle]}>Wanneer is het feest?</legend>
        <div class="aanvraag_field_row">
          <div class="aanvraag_field_wrap">
            <label class="aanvraag_label" for="aanvraag-datum">Datum</label>
            <input class="aanvraag_input" type="date" id="aanvraag-datum" name="datum" required />
          </div>
          <div class="aanvraag_field_wrap">
            <label class="aanvraag_label" for="aanvraag-tijd">
              Tijd <span class="aanvraag_label_opt u-text-style-small">(optioneel)</span>
            </label>
            <input class="aanvraag_input" type="time" id="aanvraag-tijd" name="tijd" />
          </div>
        </div>
        <p class="aanvraag_hint u-text-style-small">
          Nog geen vaste datum? Kies een richtdatum. Na het versturen kun je er meer over vertellen.
        </p>
        <div class="aanvraag_field_wrap">
          <p class="aanvraag_label">Welke momenten mogen wij verzorgen?</p>
          <div class="aanvraag_options_row">
            {
              momentOptions.map((moment) => (
                <label class="aanvraag_option_wrap">
                  <input
                    class="aanvraag_option_input"
                    type="checkbox"
                    name="momenten"
                    value={moment.value}
                  />
                  <span class="aanvraag_option_text">{moment.label}</span>
                </label>
              ))
            }
          </div>
          <p class="aanvraag_hint u-text-style-small">Meerdere kiezen mag. Twijfel je? Sla over, dan bespreken we het.</p>
        </div>
      </fieldset>

      <fieldset class="aanvraag_step is-3">
        <legend class:list={['aanvraag_step_title', stepTitleStyle]}>Waar is het feest?</legend>
        <div class="aanvraag_field_row">
          <div class="aanvraag_field_wrap">
            <label class="aanvraag_label" for="aanvraag-plaats">Plaats of locatie</label>
            <input
              class="aanvraag_input"
              type="text"
              id="aanvraag-plaats"
              name="plaats"
              required
              autocomplete="address-level2"
              list="aanvraag-plaatsen"
            />
            <datalist id="aanvraag-plaatsen">
              {places.map((place) => <option value={place} />)}
            </datalist>
          </div>
          <div class="aanvraag_field_wrap">
            <label class="aanvraag_label" for="aanvraag-gasten">Aantal gasten (schatting)</label>
            <input
              class="aanvraag_input"
              type="number"
              id="aanvraag-gasten"
              name="gasten"
              min="1"
              inputmode="numeric"
              required
            />
          </div>
        </div>
        <div class="aanvraag_field_wrap">
          <label class="aanvraag_label" for="aanvraag-locatie">
            Naam van de locatie of adres
            <span class="aanvraag_label_opt u-text-style-small">(optioneel)</span>
          </label>
          <input class="aanvraag_input" type="text" id="aanvraag-locatie" name="locatie" />
          <p class="aanvraag_hint u-text-style-small">
            Weet je alleen de naam van de zaal of het terrein? Prima, dat is genoeg.
          </p>
        </div>
      </fieldset>

      <fieldset class="aanvraag_step is-4">
        <legend class:list={['aanvraag_step_title', stepTitleStyle]}>Hoe kunnen we je bereiken?</legend>
        <div class="aanvraag_field_row is-name">
          <div class="aanvraag_field_wrap">
            <label class="aanvraag_label" for="aanvraag-naam">Je naam</label>
            <input class="aanvraag_input" type="text" id="aanvraag-naam" name="naam" required autocomplete="name" />
          </div>
          <div class="aanvraag_field_wrap is-bedrijf" hidden>
            <label class="aanvraag_label" for="aanvraag-bedrijf">Bedrijfsnaam</label>
            <input class="aanvraag_input" type="text" id="aanvraag-bedrijf" name="bedrijf" autocomplete="organization" maxlength="120" disabled />
          </div>
        </div>
        <div class="aanvraag_field_row">
          <div class="aanvraag_field_wrap">
            <label class="aanvraag_label" for="aanvraag-email">E-mailadres</label>
            <input class="aanvraag_input" type="email" id="aanvraag-email" name="email" required autocomplete="email" />
          </div>
          <div class="aanvraag_field_wrap">
            <label class="aanvraag_label" for="aanvraag-telefoon">
              Telefoonnummer <span class="aanvraag_label_opt u-text-style-small">(optioneel)</span>
            </label>
            <input class="aanvraag_input" type="tel" id="aanvraag-telefoon" name="telefoon" autocomplete="tel" />
          </div>
        </div>
        <div class="aanvraag_trap_wrap" aria-hidden="true">
          <label class="aanvraag_label" for="aanvraag-website">Website</label>
          <input
            class="aanvraag_input"
            type="text"
            id="aanvraag-website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <input type="hidden" name="ts" value="" />
      </fieldset>

      <div class="aanvraag_nav_wrap u-button-wrapper">
        <button class="aanvraag_nav_btn is-prev" type="button" data-trigger={buttonTrigger} hidden>Terug</button>
        <button class="aanvraag_nav_btn is-next" type="button" data-trigger={buttonTrigger} hidden>Volgende</button>
        <button class="aanvraag_nav_btn is-submit" type="submit" data-trigger={buttonTrigger}>Verstuur aanvraag</button>
      </div>

      <p class="aanvraag_status u-text-style-small" aria-live="polite"></p>

      <div class="aanvraag_done_wrap" hidden>
        <ChatBubble message="Gelukt, je aanvraag is binnen. Binnen 2 werkdagen hoor je van ons." />

        <div class="aanvraag_summary_wrap">
          <p class="aanvraag_done_title u-text-style-main">Dit hebben we van je</p>
          <dl class="aanvraag_summary_list">
            {[['gelegenheid', 'Gelegenheid'], ['datum', 'Datum'], ['plaats', 'Plaats'], ['gasten', 'Gasten']].map(([key, label]) => (
              <div class="aanvraag_summary_row" data-summary={key} hidden>
                <dt class="aanvraag_summary_term u-text-style-small">{label}</dt>
                <dd class="aanvraag_summary_value"></dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="aanvraag_next_wrap">
          <p class="aanvraag_done_title u-text-style-main">Zo gaat het verder</p>
          <ol class="aanvraag_next_list">
            <li class="aanvraag_next_item">Peer leest je aanvraag en kijkt of de bus vrij is.</li>
            <li class="aanvraag_next_item">Binnen 2 werkdagen nemen we contact met je op. Samen bespreken we wat je voor ogen hebt.</li>
            <li class="aanvraag_next_item">Daarna krijg je een voorstel met menu en prijs, dat past bij wat we samen hebben besproken.</li>
          </ol>
          <p class="aanvraag_hint u-text-style-small">
            Staan we net met de bus op een feest? Dan kan het soms iets langer duren. We nemen zo snel mogelijk contact met je op.
          </p>
        </div>

        <!-- After the request is in: room to tell the whole story, typed or
             spoken. Sent separately, so it never holds up the request itself. -->
        <div class="aanvraag_extra_wrap">
          <label class="aanvraag_done_title u-text-style-main" for="aanvraag-aanvulling">
            Vertel ons alles over je feest
          </label>
          <p class="aanvraag_hint u-text-style-small">
            Hoe meer we weten, hoe beter ons voorstel past. Weet je het nog niet precies? Schrijf gewoon op wat je in je hoofd hebt.
          </p>
          <div class="aanvraag_prompts" role="group" aria-label="Ideeën om over te schrijven">
            {['Wat voor sfeer wil je?', 'Wie zijn je gasten?', 'Wat moet er zeker op tafel?', 'Allergieën of dieetwensen?', 'Hoe ziet de plek eruit?', 'Hoe ziet de dag eruit?'].map((prompt) => (
              <button class="aanvraag_prompt u-text-style-small" type="button" data-prompt={prompt} data-trigger="hover focus">
                <svg class="aanvraag_prompt_icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2.500" /></svg>
                {prompt}
              </button>
            ))}
          </div>
          <textarea class="aanvraag_input is-area is-story" id="aanvraag-aanvulling" name="aanvulling" rows="7" maxlength="5000" disabled></textarea>
          <div class="aanvraag_extra_actions">
            <button class="aanvraag_mic" type="button" aria-pressed="false" hidden data-trigger="hover focus">
              <svg class="aanvraag_mic_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="2" /><path d="M5.500 11a6.500 6.500 0 0 0 13 0M12 17.500V21" stroke="currentColor" stroke-width="2" /></svg>
              <span class="aanvraag_mic_text">Inspreken</span>
            </button>
            <button class="aanvraag_nav_btn is-submit is-extra" type="button" data-trigger={buttonTrigger}>Stuur je verhaal</button>
          </div>
          <p class="aanvraag_hint is-mic u-text-style-small" hidden>
            Praten gaat sneller dan typen. Je browser zet je stem om in tekst, via zijn eigen spraakdienst (bijvoorbeeld van Google of Apple). Lees het daarna even na.
          </p>
          <p class="aanvraag_hint is-keyboard u-text-style-small">
            Tip: op je telefoon kun je ook inspreken met het microfoontje op je toetsenbord.
          </p>
          <p class="aanvraag_extra_status u-text-style-small" aria-live="polite"></p>
        </div>

        {cases.length > 0 && (
          <div class="aanvraag_cases_wrap" hidden>
            <p class="aanvraag_done_title u-text-style-main">Zo ging het bij anderen</p>
            <ul class="aanvraag_cases_list">
              {cases.map((item) => (
                <li class="aanvraag_case_item" data-gelegenheid={item.gelegenheid.toLowerCase()} hidden>
                  <a class="aanvraag_case_card" href={`${url('referenties')}#${item.slug}`} data-trigger="hover focus">
                    {item.fotoUrl && <img class="aanvraag_case_img" src={item.fotoUrl} alt="" loading="lazy" />}
                    <span class="aanvraag_case_body">
                      <span class="aanvraag_case_name">{item.titel}</span>
                      <span class="aanvraag_case_meta u-text-style-small">{item.gelegenheid} in {item.plaats}{item.gasten && `, ${item.gasten} gasten`}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="aanvraag_done_link" href={url('referenties')}>Bekijk alle feesten</a>
          </div>
        )}

        <p class="aanvraag_done_text">
          Vragen tussendoor? <a class="aanvraag_done_link" href="https://wa.me/31592656363" rel="external">App Peer</a> of bel <a class="aanvraag_done_link" href="tel:+31592656363">0592 656363</a>.
        </p>
      </div>

      <div class="aanvraag_fallback_wrap" hidden>
        <p class="aanvraag_fallback_text">
          Versturen lukte even niet. Probeer het straks nog eens, of app of
          bel ons direct, dan regelen we het zo.
        </p>
        <div class="aanvraag_fallback_actions u-button-wrapper">
          <a class="aanvraag_nav_btn is-submit" href="https://wa.me/31592656363" rel="external" data-trigger={buttonTrigger}>WhatsApp</a>
          <a class="aanvraag_nav_btn is-prev" href="tel:+31592656363" data-trigger={buttonTrigger}>Bellen</a>
        </div>
      </div>
    </form>
  </div>
</section>

<style>
  .aanvraag_contain { align-items: center; }
  .aanvraag_form_wrap {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--6);
    width: 100%;
    max-width: var(--max-width--small);
    padding: var(--_spacing---space--7);
    background-color: var(--_theme---background);
    color: var(--_theme---text);
    border: var(--border-width--main) solid var(--_theme---border);
    border-radius: var(--radius--large);
  }
  /* Embedded: the surrounding card supplies chrome and padding. */
  .aanvraag_form_wrap.is-embedded {
    gap: var(--_spacing---space--4);
    max-width: 100%;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
  }
  /* Modal: the dialog supplies theme and chrome, and the shared tokens
     and button variables switch to the heavier bus styling. */
  .aanvraag_form_wrap.is-modal {
    --radius--main: 0rem;
    --border-width--main: var(--focus--width);
    --aanvraag--option-active: var(--color--bus-yellow);
    --aanvraag--stretch: var(--_typography---stretch--poster);
    --aanvraag--btn-case: none;
    --aanvraag--btn-spacing: normal;
    --aanvraag--btn-size: var(--_typography---size--h5);
    --aanvraag--title-gap: var(--_spacing---space--4);
    gap: var(--_spacing---space--5);
    max-width: 100%;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
  }
  .aanvraag_steps_nav {
    display: flex;
    align-items: center;
  }
  .aanvraag_steps_item {
    display: flex;
    align-items: center;
    flex: 1 1 0;
  }
  .aanvraag_steps_item.is-last { flex: 0 0 auto; }
  /* Step states: enabled and not current = done (green with check),
     aria-current="step" = current (green with number), disabled =
     upcoming (light border with number). */
  .aanvraag_steps_btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Smaller than the 44px house target (owner's call), still above
       the WCAG AA minimum of 24px. */
    width: calc(var(--_spacing---space--6) + var(--_spacing---space--1));
    height: calc(var(--_spacing---space--6) + var(--_spacing---space--1));
    flex-shrink: 0;
    font-size: var(--_typography---size--small);
    background-color: var(--_theme---text-link--text);
    color: var(--_theme---background);
    border: var(--border-width--main) solid var(--_theme---text-link--text);
    border-radius: var(--radius--round);
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
    cursor: pointer;
    transition: background-color 300ms, border-color 300ms, color 300ms;
  }
  .aanvraag_steps_btn:disabled {
    --_state---true: 0;
    --_state---false: 1;
    background-color: transparent;
    color: var(--_theme---text);
    border-color: var(--_theme---border);
    cursor: default;
  }
  .aanvraag_steps_num {
    position: absolute;
    opacity: var(--_state---false);
  }
  .aanvraag_steps_check {
    position: absolute;
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
    opacity: var(--_state---true);
  }
  .aanvraag_steps_line {
    flex: 1 1 0;
    height: var(--border-width--main);
    margin-inline: var(--_spacing---space--2);
    background-color: var(--_theme---border);
  }
  .aanvraag_step {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--5);
    border: none;
    padding: 0;
    margin: 0;
  }
  .aanvraag_step_title {
    padding: 0;
    margin-bottom: var(--aanvraag--title-gap, var(--_spacing---space--2));
  }
  .aanvraag_field_wrap {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--2);
  }
  .aanvraag_label { font-weight: var(--_typography---font--primary-bold); }
  .aanvraag_label.is-small { font-size: var(--_typography---size--small); }
  .aanvraag_label_opt { font-weight: var(--_typography---font--primary-regular); }
  /* Two fields on one row where they fit; stacked on medium-down. */
  .aanvraag_field_row {
    display: var(--flex-medium, grid);
    flex-direction: column;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--_spacing---space--5);
  }
  .aanvraag_field_row.is-name { grid-template-columns: minmax(0, 1fr); }
  .aanvraag_field_row.is-name.is-double { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .aanvraag_input {
    width: 100%;
    min-height: var(--target--min);
    padding: var(--_spacing---space--3) var(--_spacing---space--4);
    background-color: var(--_theme---background-2);
    color: var(--_theme---text);
    border: var(--border-width--main) solid var(--_theme---border);
    border-radius: var(--radius--main);
  }
  .aanvraag_input.is-area {
    min-height: calc(var(--target--min) * 2);
    font-size: var(--_typography---size--small);
  }
  .aanvraag_hint { max-width: 55ch; }
  .aanvraag_options_grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--_spacing---space--3);
  }
  .aanvraag_options_row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--_spacing---space--3);
  }
  .aanvraag_option_wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--3);
    min-height: var(--target--min);
    padding: var(--_spacing---space--2) var(--_spacing---space--4);
    background-color: color-mix(
      in srgb,
      var(--_theme---background-2) calc(100% * var(--_state---true)),
      var(--aanvraag--option-active, var(--_theme---border)) calc(100% * var(--_state---false))
    );
    border: var(--border-width--main) solid var(--_theme---border);
    border-radius: var(--radius--main);
    cursor: pointer;
    transition: background-color 300ms;
  }
  .aanvraag_option_wrap.is-tile {
    justify-content: flex-start;
    font-family: var(--_typography---font--heading);
    font-stretch: var(--aanvraag--stretch, normal);
    font-weight: var(--_typography---font--primary-bold);
    word-spacing: var(--_typography---word-spacing--poster, normal);
  }
  .aanvraag_option_input {
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
    accent-color: var(--_theme---text-accent);
    flex-shrink: 0;
  }
  /* Honeypot: invisible for people, present for bots. */
  .aanvraag_trap_wrap {
    position: absolute;
    width: 0.0625rem;
    height: 0.0625rem;
    overflow: clip;
    clip-path: inset(50%);
  }
  .aanvraag_nav_wrap { justify-content: flex-start; }
  .aanvraag_nav_btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target--min);
    padding: var(--_spacing---space--3) var(--_spacing---space--5);
    border-radius: var(--radius--main);
    border-style: solid;
    border-width: var(--border-width--main);
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
    font-size: var(--aanvraag--btn-size, var(--_typography---size--small));
    font-stretch: var(--aanvraag--stretch, normal);
    letter-spacing: var(--aanvraag--btn-spacing, var(--_typography---letter-spacing--caps));
    text-transform: var(--aanvraag--btn-case, uppercase);
    word-spacing: var(--_typography---word-spacing--poster, normal);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 200ms, border-color 200ms, color 200ms;
  }
  .aanvraag_nav_btn.is-next,
  .aanvraag_nav_btn.is-submit {
    background-color: color-mix(
      in hsl,
      var(--_theme---button-primary--background) calc(100% * var(--_trigger---on)),
      var(--_theme---button-primary--background-hover) calc(100% * var(--_trigger---off))
    );
    color: color-mix(
      in hsl,
      var(--_theme---button-primary--text) calc(100% * var(--_trigger---on)),
      var(--_theme---button-primary--text-hover, var(--_theme---button-primary--text)) calc(100% * var(--_trigger---off))
    );
    border-color: color-mix(
      in hsl,
      var(--_theme---button-primary--border) calc(100% * var(--_trigger---on)),
      var(--_theme---button-primary--border-hover, var(--_theme---button-primary--border)) calc(100% * var(--_trigger---off))
    );
  }
  .aanvraag_nav_btn.is-prev {
    background-color: var(--_theme---button-secondary--background);
    color: color-mix(
      in hsl,
      var(--_theme---button-secondary--text) calc(100% * var(--_trigger---on)),
      var(--_theme---button-secondary--text-hover, var(--_theme---button-secondary--text)) calc(100% * var(--_trigger---off))
    );
    border-color: color-mix(
      in hsl,
      var(--_theme---button-secondary--border) calc(100% * var(--_trigger---on)),
      var(--_theme---button-secondary--border-hover, var(--_theme---button-secondary--border)) calc(100% * var(--_trigger---off))
    );
  }
  .aanvraag_done_wrap {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--5);
  }
  .aanvraag_done_wrap[hidden],
  .aanvraag_summary_row[hidden],
  .aanvraag_mic[hidden],
  .aanvraag_hint[hidden] { display: none; }
  .aanvraag_done_title {
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
  }
  .aanvraag_summary_wrap,
  .aanvraag_next_wrap,
  .aanvraag_extra_wrap {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--2);
  }
  .aanvraag_summary_list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size--summary-min)), 1fr));
    gap: var(--_spacing---space--2);
  }
  .aanvraag_summary_row {
    display: flex;
    flex-direction: column;
    padding: var(--_spacing---space--2) var(--_spacing---space--3);
    background-color: var(--_theme---background-2);
    border-radius: var(--radius--main);
  }
  .aanvraag_summary_value {
    font-weight: var(--_typography---font--primary-bold);
    overflow-wrap: anywhere;
  }
  .aanvraag_summary_value::first-letter { text-transform: uppercase; }
  /* A real sequence, so the numbers carry meaning. */
  .aanvraag_next_list {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--1);
    padding-left: var(--_spacing---space--5);
    list-style: decimal;
  }
  .aanvraag_extra_wrap {
    padding-top: var(--_spacing---space--4);
    border-top: var(--border-width--main) solid var(--_theme---divider, var(--_theme---border));
  }
  .aanvraag_prompts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--_spacing---space--2);
  }
  .aanvraag_prompt {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--1);
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--3);
    background-color: color-mix(in hsl, var(--_theme---border) calc(100% * var(--_trigger---off)), var(--_theme---background-2));
    color: var(--_theme---text);
    border: var(--border-width--main) solid var(--_theme---divider, var(--_theme---border));
    border-radius: var(--radius--round);
    cursor: pointer;
  }
  .aanvraag_prompt_icon,
  .aanvraag_mic_icon {
    flex: 0 0 auto;
    width: var(--_spacing---space--4);
    height: var(--_spacing---space--4);
  }
  .aanvraag_input.is-story {
    min-height: calc(var(--target--min) * 4);
    font-size: inherit;
    resize: vertical;
  }
  .aanvraag_extra_actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--_spacing---space--3);
  }
  /* Listening is pressed: filled, with a different label, never color alone. */
  .aanvraag_mic {
    display: inline-flex;
    align-items: center;
    gap: var(--_spacing---space--2);
    min-height: var(--target--min);
    padding-inline: var(--_spacing---space--4);
    background-color: color-mix(in hsl, var(--color--bus-green) calc(100% * var(--_state---false)), transparent);
    color: color-mix(in hsl, var(--color--white) calc(100% * var(--_state---false)), var(--_theme---text) calc(100% * var(--_state---true)));
    border: var(--border-width--main) solid color-mix(in hsl, var(--color--bus-green) calc(100% * var(--_trigger---off) + 100% * var(--_state---false)), var(--_theme---border));
    border-radius: var(--radius--main);
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
    cursor: pointer;
  }
  .aanvraag_extra_status:empty { display: none; }
  .aanvraag_cases_wrap,
  .aanvraag_cases_list {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--2);
  }
  .aanvraag_cases_wrap[hidden],
  .aanvraag_case_item[hidden] { display: none; }
  .aanvraag_cases_wrap { align-items: flex-start; }
  .aanvraag_cases_list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size--map-card)), 1fr));
    width: 100%;
  }
  .aanvraag_case_item { display: flex; }
  .aanvraag_case_card {
    display: flex;
    align-items: center;
    gap: var(--_spacing---space--3);
    width: 100%;
    min-height: var(--target--min);
    padding: var(--_spacing---space--2);
    background-color: var(--_theme---background-2);
    color: inherit;
    border: var(--border-width--main) solid color-mix(in hsl, var(--_theme---border) calc(100% * var(--_trigger---off)), transparent);
    border-radius: var(--radius--main);
    text-decoration: none;
  }
  .aanvraag_case_img {
    flex: 0 0 auto;
    width: var(--size--row-img-small);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius--small);
  }
  .aanvraag_case_body {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--1);
    min-width: 0;
  }
  .aanvraag_case_name {
    font-family: var(--_typography---font--heading);
    font-weight: var(--_typography---font--primary-bold);
    text-decoration: underline;
    text-underline-offset: var(--_spacing---space--1);
  }
  .aanvraag_done_link { color: var(--_theme---text-link--text, inherit); }
  .aanvraag_done_text,
  .aanvraag_fallback_text { max-width: 55ch; }
  .aanvraag_fallback_wrap {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--4);
  }
  .aanvraag_fallback_actions { justify-content: flex-start; }
</style>

<script>
  // Step logic, per-step validation, draft saving, prefill, and submit.
  const STORAGE_KEY = 'jachtbus-aanvraag-draft';

  document.querySelectorAll<HTMLFormElement>('.aanvraag_form_wrap').forEach((form) => {
    const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.aanvraag_step'));
    const progress = form.querySelector<HTMLElement>('.aanvraag_steps_nav');
    const stepButtons = Array.from(form.querySelectorAll<HTMLButtonElement>('.aanvraag_steps_btn'));
    const prevBtn = form.querySelector<HTMLButtonElement>('.aanvraag_nav_btn.is-prev');
    const nextBtn = form.querySelector<HTMLButtonElement>('.aanvraag_nav_btn.is-next');
    const submitBtn = form.querySelector<HTMLButtonElement>('.aanvraag_nav_btn.is-submit');
    const status = form.querySelector<HTMLElement>('.aanvraag_status');
    const done = form.querySelector<HTMLElement>('.aanvraag_done_wrap');
    const fallback = form.querySelector<HTMLElement>('.aanvraag_fallback_wrap');
    const nav = form.querySelector<HTMLElement>('.aanvraag_nav_wrap');
    const tsField = form.querySelector<HTMLInputElement>('input[name="ts"]');
    if (!steps.length || !prevBtn || !nextBtn || !submitBtn || !nav) return;

    let current = 0;
    if (tsField) tsField.value = String(Date.now());

    const show = (index: number, focus: boolean) => {
      current = Math.max(0, Math.min(index, steps.length - 1));
      steps.forEach((step, i) => {
        step.hidden = i !== current;
      });
      prevBtn.hidden = current === 0;
      nextBtn.hidden = current === steps.length - 1;
      submitBtn.hidden = current !== steps.length - 1;
      stepButtons.forEach((btn, i) => {
        btn.disabled = i > current;
        if (i === current) btn.setAttribute('aria-current', 'step');
        else btn.removeAttribute('aria-current');
      });
      if (focus) {
        const legend = steps[current].querySelector<HTMLElement>('.aanvraag_step_title');
        if (legend) {
          legend.tabIndex = -1;
          legend.focus();
        }
      }
    };

    const validateStep = () => {
      const fields = steps[current].querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input, textarea'
      );
      for (const field of fields) {
        if (!field.checkValidity()) {
          field.reportValidity();
          return false;
        }
      }
      return true;
    };

    const overigField = form.querySelector<HTMLElement>('.aanvraag_field_wrap.is-overig');
    const overigInput = form.querySelector<HTMLInputElement>('input[name="gelegenheid_overig"]');
    const bedrijfField = form.querySelector<HTMLElement>('.aanvraag_field_wrap.is-bedrijf');
    const bedrijfInput = form.querySelector<HTMLInputElement>('input[name="bedrijf"]');

    const syncOptionStates = () => {
      form.querySelectorAll<HTMLInputElement>('.aanvraag_option_input').forEach((input) => {
        input.closest('.aanvraag_option_wrap')?.classList.toggle('is-active', input.checked);
      });
      // "Overige" opens a short free-text field, required while shown.
      const overigChecked = !!form.querySelector<HTMLInputElement>(
        'input[name="gelegenheid"][value="overige"]:checked'
      );
      if (overigField) overigField.hidden = !overigChecked;
      if (overigInput) overigInput.required = overigChecked;
      // A company party also asks for the company. Disabled, it is not sent along.
      const bedrijfChecked = !!form.querySelector<HTMLInputElement>(
        'input[name="gelegenheid"][value="bedrijfsfeest"]:checked'
      );
      if (bedrijfField) bedrijfField.hidden = !bedrijfChecked;
      if (bedrijfInput) {
        bedrijfInput.disabled = !bedrijfChecked;
        bedrijfInput.required = bedrijfChecked;
      }
      form.querySelector('.aanvraag_field_row.is-name')?.classList.toggle('is-double', bedrijfChecked);
    };

    const saveDraft = () => {
      try {
        const data = new FormData(form);
        data.delete('website');
        data.delete('ts');
        const entries: [string, string][] = [];
        data.forEach((value, key) => {
          if (typeof value === 'string') entries.push([key, value]);
        });
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(entries));
      } catch {
        /* storage unavailable: fine, the form still works */
      }
    };

    const restoreDraft = () => {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const entries = JSON.parse(raw) as [string, string][];
        const grouped = new Map<string, string[]>();
        entries.forEach(([key, value]) => {
          grouped.set(key, [...(grouped.get(key) ?? []), value]);
        });
        grouped.forEach((values, key) => {
          form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name="${key}"]`).forEach(
            (field) => {
              if (field instanceof HTMLInputElement && (field.type === 'checkbox' || field.type === 'radio')) {
                field.checked = values.includes(field.value);
              } else {
                field.value = values[0] ?? '';
              }
            }
          );
        });
      } catch {
        /* corrupt draft: ignore */
      }
    };

    const setStatus = (message: string) => {
      if (status) status.textContent = message;
    };

    // The thank-you screen repeats the key answers, so a typo shows at once.
    const fillSummary = () => {
      const data = new FormData(form);
      const occasion = form.querySelector<HTMLInputElement>('input[name="gelegenheid"]:checked');
      const occasionText = occasion?.value === 'overige'
        ? String(data.get('gelegenheid_overig') ?? '')
        : occasion?.closest('label')?.querySelector('.aanvraag_option_text')?.textContent ?? '';
      const date = String(data.get('datum') ?? '');
      const values: Record<string, string> = {
        gelegenheid: occasionText.trim(),
        datum: date ? new Intl.DateTimeFormat('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T12:00:00Z`)) : '',
        plaats: [data.get('locatie'), data.get('plaats')].filter(Boolean).join(', '),
        gasten: String(data.get('gasten') ?? ''),
      };
      form.querySelectorAll<HTMLElement>('.aanvraag_summary_row').forEach((row) => {
        const value = values[row.dataset.summary ?? ''] ?? '';
        const cell = row.querySelector('.aanvraag_summary_value');
        if (cell) cell.textContent = value;
        row.hidden = !value;
      });
    };

    // Two earlier parties, the chosen occasion first.
    const showCases = () => {
      const wrap = form.querySelector<HTMLElement>('.aanvraag_cases_wrap');
      if (!wrap) return;
      const chosen = form.querySelector<HTMLInputElement>('input[name="gelegenheid"]:checked')?.value ?? '';
      const items = [...wrap.querySelectorAll<HTMLElement>('.aanvraag_case_item')];
      const ranked = [...items.filter((item) => item.dataset.gelegenheid === chosen), ...items.filter((item) => item.dataset.gelegenheid !== chosen)];
      items.forEach((item) => (item.hidden = true));
      ranked.slice(0, 2).forEach((item) => (item.hidden = false));
      wrap.hidden = items.length === 0;
    };

    // The story after the request: prompts, dictation and a separate send.
    const extra = (() => {
      const story = form.querySelector<HTMLTextAreaElement>('.aanvraag_input.is-story');
      const sendBtn = form.querySelector<HTMLButtonElement>('.aanvraag_nav_btn.is-extra');
      const extraStatus = form.querySelector<HTMLElement>('.aanvraag_extra_status');
      const mic = form.querySelector<HTMLButtonElement>('.aanvraag_mic');
      const micText = form.querySelector<HTMLElement>('.aanvraag_mic_text');
      const micHint = form.querySelector<HTMLElement>('.aanvraag_hint.is-mic');
      let target: { id: string; sleutel: string } | null = null;
      if (!story || !sendBtn || !extraStatus) return { open: () => {} };
      const say = (message: string) => (extraStatus.textContent = message);

      form.querySelectorAll<HTMLButtonElement>('.aanvraag_prompt').forEach((button) => {
        button.addEventListener('click', () => {
          const prompt = button.dataset.prompt ?? '';
          story.value = `${story.value.trimEnd()}${story.value.trim() ? '\n\n' : ''}${prompt} `;
          story.focus();
          story.setSelectionRange(story.value.length, story.value.length);
        });
      });

      // Dictation through the browser's own speech service: free, no key, no
      // upload by us. Only offered where it can work (it needs https).
      type Recognition = {
        lang: string;
        continuous: boolean;
        interimResults: boolean;
        start: () => void;
        stop: () => void;
        onresult: ((event: { results: ArrayLike<{ isFinal: boolean; 0: { transcript: string } }> }) => void) | null;
        onerror: ((event: { error: string }) => void) | null;
        onend: (() => void) | null;
      };
      const speechWindow = window as unknown as { SpeechRecognition?: new () => Recognition; webkitSpeechRecognition?: new () => Recognition };
      const Speech = speechWindow.SpeechRecognition ?? speechWindow.webkitSpeechRecognition;
      if (mic && micText && Speech && window.isSecureContext) {
        mic.hidden = false;
        if (micHint) micHint.hidden = false;
        let listening: Recognition | null = null;
        const stopUi = () => {
          listening = null;
          mic.setAttribute('aria-pressed', 'false');
          micText.textContent = 'Inspreken';
        };
        mic.addEventListener('click', () => {
          if (listening) {
            listening.stop();
            return;
          }
          const recognition = new Speech();
          recognition.lang = 'nl-NL';
          recognition.continuous = true;
          recognition.interimResults = true;
          const base = story.value.trim() ? `${story.value.trimEnd()} ` : '';
          recognition.onresult = (event) => {
            const spoken = Array.from(event.results, (result) => result[0].transcript).join('');
            story.value = `${base}${spoken}`;
          };
          recognition.onerror = (event) => {
            say(event.error === 'not-allowed' || event.error === 'service-not-allowed'
              ? 'Je browser geeft geen toegang tot de microfoon. Typen kan natuurlijk altijd.'
              : event.error === 'no-speech' ? 'We hoorden niets. Probeer het nog eens.' : 'Inspreken lukte even niet. Typen kan altijd.');
          };
          recognition.onend = () => {
            stopUi();
            if (story.value.trim()) say('Klaar met luisteren. Lees het even na en pas aan wat niet klopt.');
          };
          listening = recognition;
          mic.setAttribute('aria-pressed', 'true');
          micText.textContent = 'Stop met inspreken';
          say('Ik luister. Vertel maar.');
          recognition.start();
        });
      }

      sendBtn.addEventListener('click', async () => {
        const text = story.value.trim();
        if (!text) {
          say('Schrijf of spreek eerst iets in.');
          story.focus();
          return;
        }
        if (!target) {
          say('Versturen lukt hier niet. App of mail het ons gerust.');
          return;
        }
        const body = new FormData();
        body.set('id', target.id);
        body.set('sleutel', target.sleutel);
        body.set('aanvulling', text);
        sendBtn.disabled = true;
        say('Versturen...');
        try {
          const response = await fetch(`${(form.dataset.endpoint ?? '').replace(/\/$/, '')}/aanvulling`, { method: 'POST', body });
          if (!response.ok) throw new Error(String(response.status));
          say('Ontvangen, dank je wel. Wil je nog iets aanpassen? Dat kan, verstuur het gewoon opnieuw.');
        } catch {
          say('Versturen lukte even niet. Probeer het nog eens, of app het ons.');
        } finally {
          sendBtn.disabled = false;
        }
      });

      return {
        open: (to: { id: string; sleutel: string } | null) => {
          target = to;
          story.disabled = false;
          story.value = '';
          say('');
        },
      };
    })();

    // Init: turn the long form into steps.
    restoreDraft();
    const prefill = new URLSearchParams(window.location.search).get('gelegenheid');
    if (prefill) {
      const radio = form.querySelector<HTMLInputElement>(
        `input[name="gelegenheid"][value="${prefill}"]`
      );
      if (radio) radio.checked = true;
    }
    const dateField = form.querySelector<HTMLInputElement>('input[name="datum"]');
    const prefillDate = new URLSearchParams(window.location.search).get('datum');
    if (prefillDate && dateField) dateField.value = prefillDate;
    syncOptionStates();
    if (progress) progress.hidden = false;
    const checkedOccasion = form.querySelector<HTMLInputElement>('input[name="gelegenheid"]:checked');
    // "Overige" stays on step 1: its required free-text field lives there.
    show(checkedOccasion && checkedOccasion.value !== 'overige' ? 1 : 0, false);

    // Sent by a surrounding modal each time it opens. A sent request starts
    // fresh; after a failed send the answers stay, so nothing has to be retyped.
    form.addEventListener('aanvraag:open', (event) => {
      const { occasion, date } = (event as CustomEvent<{ occasion: string | null; date?: string | null }>).detail;
      const wasDone = !!done && !done.hidden;
      if (wasDone) {
        form.reset();
        form.querySelector<HTMLTextAreaElement>('.aanvraag_input.is-story')?.setAttribute('disabled', '');
      }
      if (date && dateField) dateField.value = date;
      if (done) done.hidden = true;
      if (fallback) fallback.hidden = true;
      nav.hidden = false;
      if (progress) progress.hidden = false;

      const radio = occasion
        ? form.querySelector<HTMLInputElement>(`input[name="gelegenheid"][value="${occasion}"]`)
        : null;
      if (radio) radio.checked = true;
      syncOptionStates();
      if (radio) {
        saveDraft();
        show(radio.value === 'overige' ? 0 : 1, false);
      } else {
        show(wasDone ? 0 : current, false);
      }
    });

    prevBtn.addEventListener('click', () => show(current - 1, true));
    nextBtn.addEventListener('click', () => {
      if (validateStep()) show(current + 1, true);
    });
    // The stepper only navigates back; upcoming steps stay disabled, so
    // required fields can never be skipped.
    stepButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.dataset.step ?? '0');
        if (target < current) show(target, true);
      });
    });
    form.addEventListener('input', (event) => {
      // The story after sending is no part of the draft.
      if ((event.target as HTMLElement).closest('.aanvraag_done_wrap')) return;
      syncOptionStates();
      saveDraft();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validateStep()) return;

      const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
      const endpoint = form.dataset.endpoint ?? '';
      const finish = (panel: HTMLElement | null) => {
        steps.forEach((step) => (step.hidden = true));
        nav.hidden = true;
        if (progress) progress.hidden = true;
        if (panel) {
          panel.hidden = false;
          // The button that had focus is gone, so keyboard users move along.
          panel.tabIndex = -1;
          panel.focus();
        }
      };

      if (honeypot && honeypot.value !== '') {
        // Bot: pretend success, send nothing.
        finish(done);
        return;
      }
      if (!endpoint) {
        finish(fallback);
        return;
      }

      setStatus('Versturen...');
      submitBtn.disabled = true;
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
        });
        if (!response.ok) throw new Error(String(response.status));
        const answer = (await response.json().catch(() => ({}))) as { id?: number; sleutel?: string };
        try {
          sessionStorage.removeItem(STORAGE_KEY);
        } catch {
          /* fine */
        }
        setStatus('');
        fillSummary();
        showCases();
        extra.open(answer.id && answer.sleutel ? { id: String(answer.id), sleutel: answer.sleutel } : null);
        // A real request is the conversion; the tags only exist after a yes in the cookie choice.
        window.gtag?.('event', 'generate_lead', { form: 'aanvraag', gelegenheid: form.querySelector<HTMLInputElement>('input[name="gelegenheid"]:checked')?.value });
        window.fbq?.('track', 'Lead');
        finish(done);
      } catch {
        setStatus('');
        finish(fallback);
      } finally {
        submitBtn.disabled = false;
      }
    });
  });
</script>
