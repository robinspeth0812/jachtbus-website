---
// Grid of cards built from the Card component. Each card can carry a
// photo, a paragraph, block links, or be one big link; mixing within
// one grid is fine.
import SectionHeader from './SectionHeader.astro';
import Card from './Card.astro';

interface CardLink {
  /** Where the link goes. */
  href: string;
  /** Link label. */
  label: string;
}
interface CardItem {
  /** Card heading. */
  title: string;
  /** Optional paragraph under the heading. */
  text?: string;
  /** Optional photo on top of the card. */
  image?: ImageMetadata;
  /** Alt text for the photo; keep empty when decorative. */
  alt?: string;
  /** Optional stacked block links at the bottom of the card. */
  links?: CardLink[];
  /** Makes the whole card one link; ignored when links are given. */
  href?: string;
  /** Aspect ratio of the photo. */
  aspect?: 'auto' | 'anamorphic' | 'univisium' | 'widescreen' | 'landscape' | 'portrait' | 'square';
}
interface Props {
  /** Section heading. */
  title: string;
  /** Optional intro under the heading. */
  text?: string;
  /** The cards. */
  cards: CardItem[];
  /** Section theme. */
  theme?: 'light' | 'soft' | 'brand';
}
const { title, text = '', cards, theme = 'light' } = Astro.props;
const themeClass = {
  light: 'u-theme-light',
  soft: 'u-theme-soft',
  brand: 'u-theme-brand',
}[theme];
---

<section class:list={['card-grid_wrap', 'u-section', themeClass]}>
  <div class="card-grid_contain u-container">
    <SectionHeader title={title} text={text} />
    <ul class="card-grid_layout">
      {
        cards.map((card) => (
          <li class="card-grid_item">
            <Card
              title={card.title}
              headingLevel={3}
              text={card.text}
              image={card.image}
              alt={card.alt}
              links={card.links}
              href={card.href}
              aspect={card.aspect}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .card-grid_layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--_spacing---space--5);
  }
  .card-grid_item { display: flex; }
</style>
