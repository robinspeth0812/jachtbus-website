---
// FAQ with native details/summary (keyboard and screen reader friendly
// without JS) plus FAQPage structured data for Google.
import SectionHeader from './SectionHeader.astro';

interface FaqItem {
  /** The question. */
  question: string;
  /** The answer, plain text. */
  answer: string;
}
interface Props {
  /** Section heading. */
  title?: string;
  /** Optional intro under the heading. */
  text?: string;
  /** Questions and answers. */
  items: FaqItem[];
  /** Section theme. */
  theme?: 'light' | 'soft' | 'brand';
}
const { title = 'Veelgestelde vragen', text = '', items, theme = 'light' } = Astro.props;
const themeClass = {
  light: 'u-theme-light',
  soft: 'u-theme-soft',
  brand: 'u-theme-brand',
}[theme];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<section class:list={['faq_wrap', 'u-section', themeClass]}>
  <div class="faq_contain u-container">
    <SectionHeader title={title} text={text} />
    <div class="faq_layout">
      {
        items.map((item) => (
          <details class="faq_item_wrap">
            <summary class="faq_question">
              <span class="faq_question_text u-text-style-h5">{item.question}</span>
              <svg class="faq_icon" aria-hidden="true" viewBox="0 0 16 16" fill="none">
                <path d="M4 6.5 8 10.5 12 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="faq_answer u-text-style-main">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</section>

<style>
  .faq_layout {
    display: flex;
    flex-direction: column;
    max-width: var(--max-width--small);
  }
  .faq_item_wrap {
    border-bottom: var(--border-width--main) solid var(--_theme---border);
  }
  .faq_question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--_spacing---space--4);
    min-height: var(--target--min);
    padding: var(--_spacing---space--3) 0;
    list-style: none;
    cursor: pointer;
  }
  .faq_question::-webkit-details-marker { display: none; }
  .faq_icon {
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
    transform: rotate(calc(180deg * var(--_state---false)));
    transition: transform 300ms;
  }
  .faq_answer {
    max-width: 65ch;
    padding-bottom: var(--_spacing---space--4);
  }
</style>
