# Copy to .env.local (ignored by git) and fill in. Never commit real values.

# At least 32 random characters. Production: only in Coolify.
PAYLOAD_SECRET=

# Empty = local SQLite file (jachtbus-dev.db). Production: postgresql://...
DATABASE_URL=

# Address of the portal, https://portal.jachtbusfoodtruck.nl in production
NEXT_PUBLIC_SERVER_URL=http://localhost:3010

# Started after a change in the website modules. Empty = nothing happens.
# Option 1: a plain webhook URL (POST).
# Option 2: GitHub repository_dispatch, see docs/hosting.md:
#   SITE_BUILD_HOOK_URL=https://api.github.com/repos/<owner>/<repo>/dispatches
#   SITE_BUILD_HOOK_TOKEN=<fine-grained token with Contents: read and write>
SITE_BUILD_HOOK_URL=
SITE_BUILD_HOOK_TOKEN=

# SMTP for all mail. Empty = mail is only logged (local).
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend,
# SMTP_PASS=<Resend API key>, MAIL_VAN must be on a domain verified in Resend.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_VAN=portal@jachtbusfoodtruck.nl
